---
import { getArticlesByBrand, urlForImage } from '../../../sanity/lib';
import GtmHead from '../../../components/GtmHead.astro';
import GtmBody from '../../../components/GtmBody.astro';
const posts = await getArticlesByBrand('burnscroll');
const coverUrl = (p) => p.coverImage ? urlForImage(p.coverImage).width(700).height(394).fit('crop').auto('format').url() : null;
const dateFmt = (d) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const title = 'BurnScroll Blog — Beat doomscrolling & build real focus';
const description = 'Tactics and science on screen-time control, breaking phone addiction, and turning scrolling into movement.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <GtmHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://www.realmlabs.app/burnscroll/articles" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.realmlabs.app/burnscroll/articles" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@300;400;600;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/jpeg" href="/burnscroll/logo.jpg" />
  <style>
    :root{--neon:#CEFF00;--muted:#a1a1aa;--bg:#000;--panel:#111;--line:rgba(255,255,255,.1)}
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',sans-serif;background:var(--bg);color:#fff;-webkit-font-smoothing:antialiased;position:relative}
    body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;background:radial-gradient(circle at 50% 0%,rgba(206,255,0,.05),transparent 50%)}
    body>*{position:relative;z-index:1}
    ::selection{background:var(--neon);color:#000}
    .nav{position:sticky;top:0;z-index:50;padding:18px 16px 6px;display:flex;justify-content:center}
    .nav-pill{display:flex;align-items:center;gap:6px;padding:8px 8px 8px 16px;background:rgba(255,255,255,.08);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,.1);border-radius:999px;box-shadow:0 20px 60px rgba(0,0,0,.5)}
    .brand{display:flex;align-items:center;gap:10px;font-family:'Outfit',sans-serif;font-weight:900;font-size:16px;letter-spacing:.02em;color:#fff;text-decoration:none}
    .brand img{width:30px;height:30px;border-radius:8px}
    .nav-links{display:flex;gap:2px;margin-left:6px}
    .nav-links a{color:var(--muted);text-decoration:none;font-weight:500;font-size:13px;padding:8px 14px;border-radius:999px;transition:color .16s,background .16s}
    .nav-links a:hover{color:#fff;background:rgba(255,255,255,.06)}
    .nav-app{display:inline-flex;align-items:center;gap:8px;background:#fff;color:#000;font-weight:700;font-size:13px;padding:9px 16px;border-radius:999px;text-decoration:none;margin-left:4px}
    .nav-app:hover{background:#e6e6e6}
    @media(max-width:760px){
      .nav{padding:12px 12px 4px}
      .nav-links{display:none}
      .nav-pill{padding:7px 7px 7px 14px}
      .brand{font-size:15px}
    }
    .wrap{max-width:960px;margin:0 auto;padding:0 20px}
    .hero{text-align:center;padding:64px 0 40px}
    .eyebrow{font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--neon)}
    h1{font-family:'Outfit',sans-serif;font-size:clamp(32px,5vw,52px);font-weight:900;margin:14px 0 10px;letter-spacing:-.02em}
    .sub{color:var(--muted);font-size:18px;max-width:580px;margin:0 auto}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:22px;padding:8px 0 80px}
    .card{background:var(--panel);border:1px solid var(--line);border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;display:flex;flex-direction:column;transition:transform .2s,border-color .2s}
    .card:hover{transform:translateY(-4px);border-color:rgba(206,255,0,.4)}
    .card-cover{aspect-ratio:16/9;background:linear-gradient(160deg,#1a1a1a,#000);object-fit:cover;width:100%}
    .card-body{padding:20px 22px 24px}
    .card h2{font-family:'Outfit',sans-serif;font-size:20px;font-weight:800;line-height:1.25;margin-bottom:8px;color:#fff}
    .card p{color:var(--muted);font-size:15px;line-height:1.55}
    .card .date{margin-top:14px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--neon)}
    .empty{text-align:center;color:var(--muted);padding:40px 0 90px;font-size:17px}
    footer{border-top:1px solid var(--line);padding:32px 0;text-align:center;color:var(--muted);font-size:14px}
  </style>
</head>
<body>
  <GtmBody />
  <header class="nav">
    <div class="nav-pill">
      <a class="brand" href="/burnscroll"><img src="/burnscroll/logo.jpg" alt="" width="30" height="30" />BurnScroll</a>
      <nav class="nav-links">
        <a href="/burnscroll/use-cases">Use Cases</a>
        <a href="/burnscroll/features">Features</a>
        <a href="/burnscroll/articles">Articles</a>
        <a href="/burnscroll/contact">Support</a>
      </nav>
      <a class="nav-app" href="https://apps.apple.com/us/app/burnscroll-screen-time-control/id6758544932" target="_blank" rel="noopener">App Store</a>
    </div>
  </header>

  <section class="wrap">
    <div class="hero">
      <div class="eyebrow">BurnScroll Blog</div>
      <h1>Burn the scroll. Build the focus.</h1>
      <p class="sub">{description}</p>
    </div>

    {posts.length === 0 ? (
      <p class="empty">No articles yet — first drop incoming. 🔥</p>
    ) : (
      <div class="grid">
        {posts.map((post) => (
          <a class="card" href={`/burnscroll/articles/${post.slug}`}>
            {coverUrl(post)
              ? <img class="card-cover" src={coverUrl(post)} alt={post.title} />
              : <div class="card-cover"></div>}
            <div class="card-body">
              <h2>{post.title}</h2>
              <p>{post.description}</p>
              <div class="date">{dateFmt(post.publishedAt)}</div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <footer>© BurnScroll · Burn to unlock · <a href="/">Realm Labs Studio</a></footer>
</body>
</html>
