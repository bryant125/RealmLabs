---
import { getCollection } from 'astro:content';
const posts = (await getCollection('mamabee', ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.publishedDate) - +new Date(a.data.publishedDate));
const dateFmt = (d) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const title = 'MamaBee Journal — Calm parenting & baby-tracking articles';
const description = 'Gentle, practical articles on newborn sleep, feeding, and calm parenting from the MamaBee team.';
---
<!DOCTYPE html>
<html lang="en" data-mood="golden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://www.realmlabs.app/mamabee/articles" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.realmlabs.app/mamabee/articles" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/mamabee/assets/bee.png" />
  <style>
    :root{--honey:#F0B040;--honey-dk:#D89A2E;--cream:#FFF8E8;--surface:#fff;--ink:#3D2E20;--ink-muted:#8A7A68;--divider:#F0E6D6;--shadow-card:0 10px 30px rgba(61,46,32,.10)}
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:"Nunito",system-ui,sans-serif;background:var(--cream);color:var(--ink);-webkit-font-smoothing:antialiased}
    .nav{position:sticky;top:0;z-index:50;background:rgba(255,248,232,.85);backdrop-filter:blur(16px);border-bottom:1px solid var(--divider)}
    .nav-inner{max-width:960px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:14px 20px}
    .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:19px;color:var(--ink);text-decoration:none}
    .brand img{width:38px;height:38px}
    .nav-links{display:flex;gap:22px;font-weight:700;font-size:14px}
    .nav-links a{color:var(--ink-muted);text-decoration:none}
    .nav-links a:hover{color:var(--honey-dk)}
    .wrap{max-width:960px;margin:0 auto;padding:0 20px}
    .hero{text-align:center;padding:64px 0 40px}
    .eyebrow{font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--honey-dk)}
    h1{font-size:clamp(32px,5vw,50px);font-weight:900;margin:14px 0 10px}
    .sub{color:var(--ink-muted);font-size:18px;max-width:560px;margin:0 auto}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:22px;padding:8px 0 80px}
    .card{background:var(--surface);border-radius:20px;box-shadow:var(--shadow-card);overflow:hidden;text-decoration:none;color:inherit;display:flex;flex-direction:column;transition:transform .2s}
    .card:hover{transform:translateY(-4px)}
    .card-cover{aspect-ratio:16/9;background:linear-gradient(160deg,#F6C158,#E7A636);object-fit:cover;width:100%}
    .card-body{padding:20px 22px 24px}
    .card h2{font-size:20px;font-weight:800;line-height:1.25;margin-bottom:8px}
    .card p{color:var(--ink-muted);font-size:15px;line-height:1.55}
    .card .date{margin-top:14px;font-size:13px;font-weight:700;color:var(--honey-dk)}
    .empty{text-align:center;color:var(--ink-muted);padding:40px 0 90px;font-size:17px}
    footer{border-top:1px solid var(--divider);padding:32px 0;text-align:center;color:var(--ink-muted);font-size:14px}
  </style>
</head>
<body>
  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href="/mamabee/"><img src="/mamabee/assets/bee.png" alt="" width="38" height="38" />MamaBee</a>
      <nav class="nav-links">
        <a href="/mamabee/">Home</a>
        <a href="/mamabee/articles/">Articles</a>
        <a href="/mamabee/#download">Get the app</a>
      </nav>
    </div>
  </header>

  <section class="wrap">
    <div class="hero">
      <div class="eyebrow">MamaBee Journal</div>
      <h1>Calm parenting, one honeyed article at a time</h1>
      <p class="sub">{description}</p>
    </div>

    {posts.length === 0 ? (
      <p class="empty">No articles yet — the first one is on its way. 🐝</p>
    ) : (
      <div class="grid">
        {posts.map((post) => (
          <a class="card" href={`/mamabee/articles/${post.slug}`}>
            {post.data.cover
              ? <img class="card-cover" src={post.data.cover} alt={post.data.title} />
              : <div class="card-cover"></div>}
            <div class="card-body">
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <div class="date">{dateFmt(post.data.publishedDate)}</div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <footer>© MamaBee · Made with honey by parents · <a href="/">Realm Labs</a></footer>
</body>
</html>
