---
import { getArticlesByBrand, urlForImage } from '../../../sanity/lib';
import GtmHead from '../../../components/GtmHead.astro';
import GtmBody from '../../../components/GtmBody.astro';
import MamaBeeAppBanner from '../../../components/MamaBeeAppBanner.astro';
import MamaBeeMobileNav from '../../../components/MamaBeeMobileNav.astro';
const posts = await getArticlesByBrand('mamabee');
const coverUrl = (p) => p.coverImage ? urlForImage(p.coverImage).width(700).height(394).fit('crop').auto('format').url() : null;
const dateFmt = (d) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const title = 'MamaBee Journal — Calm parenting & baby-tracking articles';
const description = 'Gentle, practical articles on newborn sleep, feeding, and calm parenting from the MamaBee team.';
---
<!DOCTYPE html>
<html lang="en" data-mood="golden">
<head>
  <GtmHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://www.realmlabs.app/mamabee/articles" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.realmlabs.app/mamabee/articles" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/mamabee/assets/bee.png" />
  <style>
    :root{--honey:#F0B040;--honey-dk:#D89A2E;--cream:#FCEBCE;--surface:#fff;--ink:#3D2E20;--ink-muted:#8A7A68;--divider:#F0E6D6;--shadow-card:0 10px 30px rgba(61,46,32,.10)}
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:"Nunito",system-ui,sans-serif;background:var(--cream);color:var(--ink);-webkit-font-smoothing:antialiased}
    .nav{position:sticky;top:0;z-index:50;background:rgba(252,235,206,.9);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--divider)}
    .nav-inner{max-width:1120px;margin:0 auto;display:flex;align-items:center;gap:28px;height:78px;padding:0 24px}
    .brand{display:inline-flex;align-items:center;gap:12px;font-family:"Nunito",sans-serif;font-weight:900;font-size:1.4rem;letter-spacing:-.02em;color:var(--ink);text-decoration:none}
    .brand .bee-logo{width:46px;height:46px;object-fit:contain;flex:none;filter:drop-shadow(0 3px 5px rgba(61,46,32,.18));transition:transform .25s cubic-bezier(.2,.8,.3,1.4)}
    .brand:hover .bee-logo{transform:rotate(-8deg) scale(1.06)}
    .nav-links{display:flex;gap:8px;margin-left:12px}
    .nav-links a{font-weight:800;font-size:1rem;color:var(--ink-muted);padding:9px 15px;border-radius:12px;white-space:nowrap;text-decoration:none;transition:color .16s,background-color .16s}
    .nav-links a:hover{color:#643018;background:#FDF1D2}
    .nav-cta{margin-left:auto;display:flex;align-items:center;gap:14px}
    .btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;font-size:.98rem;border-radius:15px;font-weight:800;font-family:"Nunito",sans-serif;text-decoration:none;transition:filter .16s,transform .06s}
    .btn-primary{background:linear-gradient(160deg,#F6C158 0%,#E7A636 100%);color:#643018;box-shadow:0 5px 0 #B97E1F,0 4px 16px rgba(61,46,32,.07)}
    .btn-primary:hover{filter:brightness(1.02)}
    .btn-primary:active{transform:translateY(4px);box-shadow:0 1px 0 #B97E1F}
    @media(max-width:760px){
      .nav-inner{height:62px;gap:12px;padding:0 16px}
      .nav-links{display:none}
      .brand{font-size:1.2rem}
      .brand .bee-logo{width:38px;height:38px}
      .nav-cta .btn{min-height:42px;padding:0 16px;font-size:.9rem}
    }
    .wrap{max-width:1120px;margin:0 auto;padding:0 24px}
    .hero{text-align:center;padding:64px 0 40px}
    .eyebrow{font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--honey-dk)}
    h1{font-size:clamp(32px,5vw,50px);font-weight:900;margin:14px 0 10px}
    .sub{color:var(--ink-muted);font-size:18px;max-width:560px;margin:0 auto}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:22px;padding:8px 0 80px}
    @media(max-width:620px){
      .grid{grid-template-columns:1fr 1fr;gap:14px;padding:8px 0 60px}
      .card-body{padding:13px 14px 16px}
      .card h2{font-size:15px;line-height:1.25}
      .card p{font-size:12.5px;line-height:1.45}
      .card .date{font-size:11.5px;margin-top:10px}
    }
    .card{background:var(--surface);border-radius:20px;box-shadow:var(--shadow-card);overflow:hidden;text-decoration:none;color:inherit;display:flex;flex-direction:column;transition:transform .2s}
    .card:hover{transform:translateY(-4px)}
    .card-cover{aspect-ratio:16/9;background:linear-gradient(160deg,#F6C158,#E7A636);object-fit:cover;width:100%}
    .card-body{padding:20px 22px 24px}
    .card h2{font-size:20px;font-weight:800;line-height:1.25;margin-bottom:8px;display:-webkit-box;-webkit-line-clamp:3;line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
    .card p{color:var(--ink-muted);font-size:15px;line-height:1.55;display:-webkit-box;-webkit-line-clamp:3;line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
    .card .date{margin-top:14px;font-size:13px;font-weight:700;color:var(--honey-dk)}
    .empty{text-align:center;color:var(--ink-muted);padding:40px 0 90px;font-size:17px}
    footer{border-top:1px solid var(--divider);padding:32px 0;text-align:center;color:var(--ink-muted);font-size:14px}
  </style>
</head>
<body>
  <GtmBody />
  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href="/mamabee/"><img class="bee-logo" src="/mamabee/assets/bee.png" alt="" width="46" height="46" />MamaBee</a>
      <nav class="nav-links">
        <a href="/mamabee/#how">How it works</a>
        <a href="/mamabee/#features">Features</a>
        <a href="/mamabee/#ai">AI</a>
        <a href="/mamabee/#faq">FAQ</a>
        <a href="/mamabee/tools">Free tools</a>
        <a href="/mamabee/articles">Articles</a>
      </nav>
      <div class="nav-cta">
        <a class="btn btn-primary" href="https://apps.apple.com/us/app/mamabee-baby-tracker/id6773179521" target="_blank" rel="noopener">Get the app</a>
        <button class="nav-toggle" id="mbToggle" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
      </div>
    </div>
  </header>
  <MamaBeeMobileNav />

  <div style="padding:0 24px"><MamaBeeAppBanner /></div>

  <section class="wrap">
    <div class="hero">
      <div class="eyebrow">MamaBee Journal</div>
      <h1>Calm parenting, one honeyed article at a time</h1>
      <p class="sub">{description}</p>
    </div>

    {posts.length === 0 ? (
      <p class="empty">No articles yet — the first one is on its way. 🐝</p>
    ) : (
      <div class="grid">
        {posts.map((post) => (
          <a class="card" href={`/mamabee/articles/${post.slug}`}>
            {coverUrl(post)
              ? <img class="card-cover" src={coverUrl(post)} alt={post.title} />
              : <div class="card-cover"></div>}
            <div class="card-body">
              <h2>{post.title}</h2>
              <p>{post.description}</p>
              <div class="date">{dateFmt(post.publishedAt)}</div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <footer>© MamaBee · Made with honey by parents · <a href="/">Realm Labs</a></footer>
</body>
</html>
