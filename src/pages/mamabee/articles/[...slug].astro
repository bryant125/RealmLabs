---
import MamaBeeArticle from '../../../layouts/MamaBeeArticle.astro';
import { getArticlesByBrand, getRelated, readingMinutes, extractFaq, urlForImage, renderBody } from '../../../sanity/lib';
import { articleTool } from '../../../data/mamabeeTools';

export async function getStaticPaths() {
  const posts = await getArticlesByBrand('mamabee');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const bodyHtml = renderBody(post.body, 'mamabee');
const cover = post.coverImage
  ? urlForImage(post.coverImage).width(1600).fit('max').auto('format').url()
  : undefined;
const readingTime = readingMinutes(post.body);
const faq = extractFaq(post.body);
const related = (await getRelated('mamabee', post.slug, 3)).map((a) => ({
  title: a.title,
  slug: a.slug,
  cover: a.coverImage ? urlForImage(a.coverImage).width(480).height(270).fit('crop').auto('format').url() : null,
}));
const canonical = `/mamabee/articles/${post.slug}`;
const tool = articleTool(post.slug);

// wordCount for Article schema — engines use length as a depth signal.
let wordCount = 0;
for (const b of post.body ?? []) {
  if (b?._type === 'block' && Array.isArray(b.children))
    for (const s of b.children) if (s?.text) wordCount += s.text.split(/\s+/).filter(Boolean).length;
}

// The four-way comparison is literally a list of apps — expose it as an
// ItemList so answer engines can lift the comparison set intact.
const COMPARISON_HUB = 'best-baby-tracker-apps-compared';
const itemList = post.slug === COMPARISON_HUB ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Baby tracker apps compared',
  itemListOrder: 'https://schema.org/ItemListUnordered',
  numberOfItems: 4,
  itemListElement: [
    ['Huckleberry', 'iOS, Android', 'https://apps.apple.com/us/app/huckleberry-baby-child/id1169136078'],
    ['PiyoLog', 'iOS, Android', 'https://apps.apple.com/us/app/piyolog-newborn-baby-tracker/id1252857347'],
    ['Baby Tracker - Newborn Log', 'iOS, iPadOS, Android', 'https://apps.apple.com/us/app/baby-tracker-newborn-log/id779656557'],
    ['MamaBee', 'iOS', 'https://apps.apple.com/us/app/mamabee-baby-tracker/id6773179521'],
  ].map(([name, os, url], i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: { '@type': 'MobileApplication', name, operatingSystem: os, applicationCategory: 'HealthApplication', installUrl: url },
  })),
} : null;
---
<MamaBeeArticle
  title={post.title}
  description={post.description}
  publishedDate={post.publishedAt}
  author={post.author}
  cover={cover}
  canonical={canonical}
  readingTime={readingTime}
  related={related}
  faq={faq}
  tool={tool}
  wordCount={wordCount}
  itemList={itemList}
>
  <Fragment set:html={bodyHtml} />
</MamaBeeArticle>
