---
import MamaBeeArticle from '../../../layouts/MamaBeeArticle.astro';
import { getArticlesByBrand, urlForImage, renderBody } from '../../../sanity/lib';

export async function getStaticPaths() {
  const posts = await getArticlesByBrand('mamabee');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const bodyHtml = renderBody(post.body);
const cover = post.coverImage
  ? urlForImage(post.coverImage).width(1600).fit('max').auto('format').url()
  : undefined;
const canonical = `/mamabee/articles/${post.slug}`;
---
<MamaBeeArticle
  title={post.title}
  description={post.description}
  publishedDate={post.publishedAt}
  author={post.author}
  cover={cover}
  canonical={canonical}
>
  <Fragment set:html={bodyHtml} />
</MamaBeeArticle>
