---
import MamaBeeMobileNav from '../../components/MamaBeeMobileNav.astro';

const title = 'Privacy Policy | MamaBee';
const description =
  'How MamaBee handles your data. By default everything you log stays on your device — sharing, AI, and voice are optional and off until you turn them on.';
const canonical = 'https://www.realmlabs.app/mamabee/privacy';
const appUrl = 'https://apps.apple.com/us/app/mamabee-baby-tracker/id6773179521';
const effective = '30 July 2026';
const updated = '30 July 2026';
const contact = 'support@realmlabs.app';
---
<!DOCTYPE html>
<html lang="en" data-mood="golden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/mamabee/assets/bee.png" />
  <style is:global>
    :root{--honey:#F0B040;--honey-dk:#D89A2E;--cream:#FCEBCE;--cream-tint:#FBF1DA;--surface:#fff;--ink:#3D2E20;--ink-muted:#8A7A68;--divider:#F0E6D6;--cocoa:#643018;--shadow:0 10px 30px rgba(61,46,32,.1)}
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:"Nunito",system-ui,sans-serif;background:var(--cream);color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.6}
    a{color:var(--honey-dk)}
    .nav{position:sticky;top:0;z-index:50;background:rgba(252,235,206,.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--divider)}
    .nav-inner{max-width:1000px;margin:0 auto;display:flex;align-items:center;gap:20px;height:70px;padding:0 22px}
    .brand{display:inline-flex;align-items:center;gap:11px;font-weight:900;font-size:1.35rem;color:var(--ink);text-decoration:none;letter-spacing:-.02em}
    .brand img{width:42px;height:42px}
    .nav-links{display:flex;gap:8px;margin-left:12px}
    .nav-links a{font-weight:800;font-size:1rem;color:var(--ink-muted);padding:9px 15px;border-radius:12px;text-decoration:none;transition:color .16s,background-color .16s}
    .nav-links a:hover,.nav-links a[aria-current]{color:#643018;background:#FDF1D2}
    .nav-cta{margin-left:auto;display:flex;gap:14px;align-items:center}
    .btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 26px;border-radius:15px;font-weight:800;font-family:"Nunito",sans-serif;font-size:1rem;text-decoration:none;border:none;cursor:pointer;background:linear-gradient(160deg,#F6C158,#E7A636);color:var(--cocoa);box-shadow:0 5px 0 #B97E1F,var(--shadow);transition:filter .16s,transform .06s}
    .btn:hover{filter:brightness(1.03)}
    .btn:active{transform:translateY(4px);box-shadow:0 1px 0 #B97E1F}
    .wrap{max-width:760px;margin:0 auto;padding:0 22px}
    .hero{text-align:center;padding:52px 0 6px}
    .eyebrow{font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--honey-dk)}
    h1{font-size:clamp(30px,5.5vw,44px);font-weight:900;line-height:1.1;letter-spacing:-.02em;margin:12px 0 12px;text-wrap:balance}
    .dates{color:var(--ink-muted);font-weight:700;font-size:15px}
    /* the plain-English summary up top */
    .tldr{background:linear-gradient(160deg,#FDF1D2,#FCE7B5);border:1px solid var(--divider);border-radius:22px;padding:28px 26px;margin:28px 0}
    .tldr h2{font-size:22px;font-weight:900;margin-bottom:10px}
    .tldr p{margin-bottom:12px}
    .tldr ol{margin:0 0 12px 20px;display:grid;gap:9px}
    .tldr li{padding-left:4px}
    /* policy body */
    .policy{background:var(--surface);border-radius:26px;box-shadow:var(--shadow);padding:34px 32px;margin:0 0 26px}
    .policy h2{font-size:22px;font-weight:900;margin:34px 0 12px;letter-spacing:-.01em;scroll-margin-top:86px}
    .policy h2:first-child{margin-top:0}
    .policy p{margin:0 0 14px}
    .policy ul{margin:0 0 16px 20px;display:grid;gap:10px}
    .policy li{padding-left:3px}
    .policy strong{font-weight:800}
    .tbl-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:0 0 18px}
    table.sub{width:100%;min-width:520px;border-collapse:collapse;font-size:15px}
    table.sub th,table.sub td{text-align:left;padding:12px 13px;border-bottom:1px solid var(--divider);vertical-align:top}
    table.sub th{font-weight:800;color:var(--ink-muted);font-size:12px;letter-spacing:.06em;text-transform:uppercase}
    table.sub td:first-child{font-weight:800}
    .contact-box{background:var(--cream-tint);border-radius:18px;padding:22px 24px;margin-top:26px}
    .contact-box p{margin:0}
    footer{border-top:1px solid var(--divider);padding:34px 0;text-align:center;color:var(--ink-muted);font-size:14px;margin-top:20px}
    @media(max-width:600px){.policy{padding:26px 20px;border-radius:20px}}
  </style>
</head>
<body>
  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href="/mamabee/"><img src="/mamabee/assets/bee.png" alt="" width="42" height="42" />MamaBee</a>
      <nav class="nav-links">
        <a href="/mamabee/#how">How it works</a>
        <a href="/mamabee/#features">Features</a>
        <a href="/mamabee/#ai">AI</a>
        <a href="/mamabee/#faq">FAQ</a>
        <a href="/mamabee/tools">Free tools</a>
        <a href="/mamabee/articles">Articles</a>
      </nav>
      <div class="nav-cta">
        <a class="btn" href={appUrl} target="_blank" rel="noopener" style="min-height:44px;padding:0 20px">Get the app</a>
        <button class="nav-toggle" id="mbToggle" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
      </div>
    </div>
  </header>
  <MamaBeeMobileNav />

  <section class="wrap">
    <div class="hero">
      <div class="eyebrow">MamaBee</div>
      <h1>Privacy Policy</h1>
      <p class="dates">Effective {effective} · Last updated {updated}</p>
    </div>

    <div class="tldr">
      <h2>The short version</h2>
      <p>MamaBee helps you track your baby. <strong>By default, everything you log — your baby’s profile, photos, and every entry — lives only on your device.</strong> We don’t sell your data, and we don’t show ads inside the app.</p>
      <p>Your records leave your device only in these cases:</p>
      <ol>
        <li><strong>Co-Parent Sharing (optional).</strong> If you turn it on, your baby profile, logs, notes, and full-size photos are copied to our secure cloud so the people you invite can see them.</li>
        <li><strong>Bee AI Assistant (optional).</strong> When you ask a question, we send your baby’s logged data and first name to our AI processing provider so it can answer personally — never your photos or your written notes.</li>
        <li><strong>Voice logging (optional).</strong> Your speech is turned into text on your device, then handled exactly like a typed Bee AI request.</li>
        <li><strong>Export (you choose).</strong> We hand you a file; what you do with it is up to you.</li>
        <li><strong>Anonymous usage statistics.</strong> Which screens are used and that the app was opened — never the contents of your logs.</li>
      </ol>
      <p style="margin-bottom:0">If you never turn on sharing, AI, or voice, your data stays on your device (and, if you enable it, your private Apple iCloud).</p>
    </div>

    <article class="policy">
      <h2 id="who-we-are">1. Who we are</h2>
      <p>MamaBee is provided by <strong>Realm Labs Studio</strong> (“we”, “us”, “our”). For any privacy question or request, contact us at <a href={`mailto:${contact}`}>{contact}</a>.</p>

      <h2 id="what-we-collect">2. Information we collect</h2>
      <p>We only collect what you type or tap into the app:</p>
      <ul>
        <li><strong>Baby profile</strong> — name, date and time of birth, gender, country, and an optional photo.</li>
        <li><strong>Tracking logs</strong> — sleep, feeds, diaper changes (including any photo you attach), growth measurements, health events, milestones, activities, vaccinations, and any free-text notes you add to an entry.</li>
        <li><strong>App preferences</strong> — measurement units, layout order, country selection.</li>
        <li><strong>Anonymous usage data</strong> — a random ID we generate for your install (not your name, email, or Apple ID), your app version, and your device’s region and language.</li>
        <li><strong>Purchase status</strong> — whether you hold an active subscription, handled by Apple and our subscription provider.</li>
      </ul>
      <p>We do <strong>not</strong> collect your location or your contacts.</p>

      <h2 id="where-stored">3. Where your data is stored, and when it leaves your device</h2>
      <ul>
        <li><strong>On your device (default).</strong> Your data is stored locally on your device in Apple’s on-device database. If you never enable the optional features below, it stays there.</li>
        <li><strong>Apple iCloud (optional, Apple-operated).</strong> If iCloud Drive is enabled for MamaBee, your data — including your photos and notes — syncs privately across your own Apple devices. Apple performs this sync directly; we never see the synced data.</li>
        <li><strong>Co-Parent Sharing (optional, our cloud).</strong> If you turn this on, your baby profile, logs, notes, and full-size photos are copied to our secure cloud database and file storage so the people you invite can see them. Access is restricted to members of your family group by security rules. As the operator, we can technically access this data to run and support the service, but we do not inspect it, sell it, or use it for advertising. Leaving a shared family stops the sync.</li>
        <li><strong>Photos.</strong> Photos you attach stay on your device by default. They leave your device only through your own Apple iCloud sync, or if you enable Co-Parent Sharing — in which case they are visible only to your family group.</li>
      </ul>

      <h2 id="ai">4. Bee AI Assistant and voice logging (optional)</h2>
      <p>When you use the AI assistant, we send to our AI processing provider:</p>
      <ul>
        <li>your typed (or spoken, then transcribed) question;</li>
        <li>a summary of your baby’s logged history (sleep, feeds, diapers, growth, solids/allergens, milestones, activities, vaccinations, including trends over time);</li>
        <li>your baby’s <strong>first name</strong>, age, date of birth, and gender, so the answer is personal.</li>
      </ul>
      <p>We do <strong>not</strong> send your baby’s <strong>photo</strong> or your <strong>free-text notes</strong> to the AI provider. For voice logging, your speech is converted to text using Apple’s speech-recognition technology; we do not store the audio recording.</p>

      <h2 id="analytics">5. Analytics, and advertising measurement</h2>
      <ul>
        <li><strong>Product &amp; usage analytics.</strong> We use privacy-focused analytics to understand which screens are used and whether the app is working. These services receive: which screen you opened and when; that a log was created and its type (never its contents); your app version, region, and language. They never receive your baby’s name, birth date, measurements, health records, photos, or anything you typed.</li>
        <li><strong>Advertising measurement.</strong> We use advertising-measurement tools to see whether our ads bring people to the app. We do not use your data to build advertising profiles or to target ads inside the app. Apple’s <strong>App Tracking Transparency</strong> prompt controls whether these tools may use your device’s advertising identifier; choosing “Ask App Not to Track” is fully respected.</li>
      </ul>

      <h2 id="providers">6. Categories of service providers</h2>
      <p>We do not sell your data. We rely on a small number of service providers to operate the app. Each only receives what a given feature requires:</p>
      <div class="tbl-scroll">
        <table class="sub">
          <thead>
            <tr><th>Category of provider</th><th>Purpose</th><th>What it may receive</th></tr>
          </thead>
          <tbody>
            <tr><td>Apple</td><td>iCloud sync, on-device speech-to-text, App Store purchases</td><td>iCloud-synced data (encrypted, we can’t see it); spoken audio for transcription; purchase records</td></tr>
            <tr><td>Cloud hosting &amp; storage provider</td><td>Co-Parent Sharing cloud database and photo storage; app analytics</td><td>Shared baby profile, logs, notes, and photos (only if sharing is on); anonymous usage events</td></tr>
            <tr><td>AI processing provider</td><td>Bee AI answers and voice-log parsing</td><td>Your question and the baby-data summary described in section 4 — no photos, no notes</td></tr>
            <tr><td>Subscription management provider</td><td>Manage subscriptions</td><td>Anonymous purchase/subscription status</td></tr>
            <tr><td>Advertising-measurement partners</td><td>Measure ad performance</td><td>Anonymous install/measurement events, subject to your ATT choice</td></tr>
          </tbody>
        </table>
      </div>
      <p>All providers are bound by contract to process data only on our instructions, and none of them may use your data for their own purposes. If you need us to identify a specific provider in connection with a data-protection request, contact us at <a href={`mailto:${contact}`}>{contact}</a>.</p>

      <h2 id="children">7. Children’s data</h2>
      <p>MamaBee is used by <strong>parents and caregivers</strong> to record information about their own child. We do not knowingly allow children to create accounts or use the app themselves. Because the data concerns a child, we treat it as sensitive: it is not sold, not used for advertising, and not used to build advertising profiles. If you believe a child has used the app directly, contact us at <a href={`mailto:${contact}`}>{contact}</a> and we will assist.</p>

      <h2 id="retention">8. Data retention and deletion</h2>
      <ul>
        <li>Data stored on your device remains until you delete it or uninstall the app.</li>
        <li>Data copied to our cloud for Co-Parent Sharing is retained while sharing is active. Leaving a shared family stops further syncing. <strong>Deleting your account</strong> removes the records we hold in our cloud, including shared photos and notes.</li>
        <li>You can delete any individual entry or photo at any time from within the app.</li>
      </ul>

      <h2 id="rights">9. Your rights</h2>
      <p>Depending on where you live (e.g. under GDPR or CCPA/CPRA), you may have the right to access, correct, export, or delete your data, and to object to certain processing. Because most data lives on your device, you can exercise most of these directly:</p>
      <ul>
        <li><strong>Export</strong> — Profile → Data → Export.</li>
        <li><strong>Edit / delete entries</strong> — from the timeline.</li>
        <li><strong>Delete everything</strong> — Profile → Account → Delete Account.</li>
      </ul>
      <p>For any request we can’t fulfil in-app, contact <a href={`mailto:${contact}`}>{contact}</a>.</p>

      <h2 id="security">10. Security</h2>
      <p>We restrict access to shared cloud data to members of your family group using security rules, and we transmit data over encrypted connections. No system is perfectly secure, but we take reasonable measures to protect your information.</p>

      <h2 id="international">11. International users</h2>
      <p>Your data may be processed in countries other than your own, including where our providers operate. Where required, we rely on appropriate safeguards for such transfers.</p>

      <h2 id="changes">12. Changes to this policy</h2>
      <p>We may update this policy as the app evolves. Material changes will be reflected here with a new “Last updated” date, and where appropriate we will notify you in the app.</p>

      <h2 id="contact">13. Contact</h2>
      <div class="contact-box">
        <p>Questions or requests: <a href={`mailto:${contact}`}>{contact}</a><br />Realm Labs Studio</p>
      </div>
    </article>
  </section>

  <footer>
    <a href="/mamabee/">MamaBee</a> — the calm, AI-powered baby tracker · <a href="/">Realm Labs</a>
  </footer>
</body>
</html>
