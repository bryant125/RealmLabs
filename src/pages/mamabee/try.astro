---
import MamaBeeMobileNav from '../../components/MamaBeeMobileNav.astro';
const title = 'Try MamaBee Free in Your Browser — One-Tap Baby Tracker Demo';
const description = 'Try the MamaBee baby tracker right in your browser — log sleep, feeds and diapers with one tap and see your baby’s day on a live timeline. No sign-up, your data stays on your device.';
const canonical = 'https://www.realmlabs.app/mamabee/try';
const appUrl = 'https://apps.apple.com/us/app/mamabee-baby-tracker/id6773179521';
const faq = [
  { q: 'Is this the full MamaBee app?', a: 'No — this is a free, simplified web demo so you can feel the one-tap logging before you download. The iPhone app adds AI insights, automatic nap prediction, co-parent sync, growth charts, milestones and much more.' },
  { q: 'Where is my data stored?', a: 'Entirely in your own browser, on this device. Nothing is sent to us or anyone else — clearing your browser data clears the demo. The real app keeps your data on your device too, and only syncs if you turn on co-parent sharing.' },
  { q: 'Do I need to sign up?', a: 'No sign-up, no account, no email required to use the demo. Just start tapping.' },
  { q: 'Will my demo log transfer to the app?', a: 'No — the demo is a standalone taste of the experience. When you download MamaBee you start fresh on your phone, where everything is saved, backed up and made smarter with AI.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const appSchema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'MamaBee Baby Tracker (Web Demo)', applicationCategory: 'HealthApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, url: canonical };
---
<!DOCTYPE html>
<html lang="en" data-mood="golden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://www.realmlabs.app/mamabee/assets/bee.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/mamabee/assets/bee.png" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <style is:global>
    :root{--honey:#F0B040;--honey-dk:#D89A2E;--cream:#FCEBCE;--cream-tint:#FBF1DA;--surface:#fff;--ink:#3D2E20;--ink-muted:#8A7A68;--divider:#F0E6D6;--cocoa:#643018;--shadow:0 10px 30px rgba(61,46,32,.1);--sleep:#7C6FD0;--sleep-dk:#6E60C4;--feed:#E7893C;--feed-dk:#DA7723;--diaper:#4FA98A;--diaper-dk:#3E9878}
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{overflow-x:hidden;max-width:100%}
    body{font-family:"Nunito",system-ui,sans-serif;background:var(--cream);color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.6}
    img{max-width:100%}
    a{color:var(--honey-dk)}
    .nav{position:sticky;top:0;z-index:50;background:rgba(252,235,206,.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--divider)}
    .nav-inner{max-width:1000px;margin:0 auto;display:flex;align-items:center;gap:20px;height:70px;padding:0 22px}
    .brand{display:inline-flex;align-items:center;gap:11px;font-weight:900;font-size:1.35rem;color:var(--ink);text-decoration:none;letter-spacing:-.02em}
    .brand img{width:42px;height:42px}
    .nav-links{display:flex;gap:8px;margin-left:12px}
    .nav-links a{font-weight:800;font-size:1rem;color:var(--ink-muted);padding:9px 15px;border-radius:12px;text-decoration:none;transition:color .16s,background-color .16s}
    .nav-links a:hover{color:var(--ink);background:rgba(255,255,255,.5)}
    .nav-cta{margin-left:auto;display:flex;gap:14px;align-items:center}
    .nav-toggle{display:none;flex-direction:column;gap:5px;background:none;border:0;cursor:pointer;padding:8px}
    .nav-toggle span{display:block;width:24px;height:2px;background:var(--ink);border-radius:2px}
    .btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 26px;border-radius:15px;font-weight:800;font-family:"Nunito",sans-serif;font-size:1rem;text-decoration:none;border:none;cursor:pointer;background:linear-gradient(160deg,#F6C158,#E7A636);color:var(--cocoa);box-shadow:0 5px 0 #B97E1F,var(--shadow);transition:filter .16s,transform .06s}
    .btn:hover{filter:brightness(1.03)}
    .btn:active{transform:translateY(4px);box-shadow:0 1px 0 #B97E1F}
    .wrap{width:100%;max-width:720px;margin:0 auto;padding:0 22px}
    .hero{text-align:center;padding:44px 0 6px}
    .eyebrow{font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--honey-dk)}
    h1{font-size:clamp(25px,6vw,44px);font-weight:900;line-height:1.12;letter-spacing:-.02em;margin:12px 0 12px;overflow-wrap:break-word}
    .sub{color:var(--ink-muted);font-size:clamp(15px,4vw,18px);max-width:52ch;margin:0 auto}

    /* ---- phone-framed tracker ---- */
    .phone{width:100%;max-width:412px;margin:28px auto;background:var(--surface);border-radius:30px;box-shadow:0 20px 50px rgba(61,46,32,.16);border:1px solid var(--divider);padding:16px 16px 20px;position:relative}
    .phone-top{display:flex;align-items:center;gap:10px;padding:8px 8px 14px}
    .phone-top .avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(160deg,#FDE2A6,#F6C158);display:flex;align-items:center;justify-content:center}
    .phone-top .avatar img{width:26px;height:26px}
    .phone-top .who{line-height:1.15}
    .phone-top .who b{font-size:16px;font-weight:900;display:block}
    .phone-top .who span{font-size:12.5px;color:var(--ink-muted);font-weight:700}
    .phone-top .day{margin-left:auto;font-size:12px;font-weight:800;color:var(--ink-muted);text-transform:uppercase;letter-spacing:.06em}

    .insight{display:flex;gap:10px;align-items:center;background:linear-gradient(160deg,#FDF1D2,#FCE7B5);border-radius:16px;padding:12px 14px;font-weight:700;color:var(--ink);margin:0 4px 16px;font-size:14.5px;line-height:1.4}
    .insight img{width:24px;height:24px;flex-shrink:0}

    .btn-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:0 4px}
    .log-btn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;min-height:98px;border-radius:20px;border:none;cursor:pointer;font-family:inherit;font-weight:800;font-size:1.02rem;color:#fff;box-shadow:0 6px 16px rgba(61,46,32,.16);transition:transform .07s,filter .16s;padding:8px;-webkit-tap-highlight-color:transparent}
    .log-btn:active{transform:scale(.95)}
    .log-btn .ic{font-size:29px;line-height:1}
    .log-btn .st{font-size:11px;font-weight:800;opacity:.92;min-height:14px;text-transform:uppercase;letter-spacing:.03em}
    .log-btn.sleep{background:linear-gradient(160deg,#8E80E0,#6E60C4)}
    .log-btn.feed{background:linear-gradient(160deg,#F09A4C,#E37C2C)}
    .log-btn.diaper{background:linear-gradient(160deg,#5FBE9C,#419C7E)}
    .log-btn.running{box-shadow:0 0 0 3px rgba(255,255,255,.6),0 6px 16px rgba(61,46,32,.22);animation:pulse 1.7s ease-in-out infinite}
    @keyframes pulse{0%,100%{filter:brightness(1)}50%{filter:brightness(1.13)}}

    .subrow{display:none;gap:8px;margin:12px 4px 0;flex-wrap:wrap;justify-content:center;animation:drop .18s ease}
    .subrow.show{display:flex}
    @keyframes drop{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
    .chip{border:none;cursor:pointer;font-family:inherit;font-weight:800;font-size:.92rem;padding:11px 16px;border-radius:13px;background:var(--cream-tint);color:var(--ink);border:2px solid var(--divider);-webkit-tap-highlight-color:transparent}
    .chip:active{transform:scale(.95)}

    .tl-head{display:flex;align-items:baseline;justify-content:space-between;margin:22px 4px 10px}
    .tl-head h2{font-size:15px;font-weight:900;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-muted)}
    .tl-head button{background:none;border:none;color:var(--ink-muted);font-weight:800;font-family:inherit;cursor:pointer;font-size:13px;text-decoration:underline}
    .timeline{list-style:none;display:flex;flex-direction:column;gap:9px;padding:0 4px}
    .empty{text-align:center;color:var(--ink-muted);padding:24px 10px;font-weight:700;font-size:14.5px}
    .ev{display:flex;align-items:center;gap:12px;background:var(--cream-tint);border-radius:16px;padding:11px 12px;border:1px solid var(--divider)}
    .ev .dot{width:42px;height:42px;border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:21px;flex-shrink:0;box-shadow:inset 0 0 0 100px rgba(255,255,255,.12)}
    .ev.sleep .dot{background:var(--sleep)}.ev.feed .dot{background:var(--feed)}.ev.diaper .dot{background:var(--diaper)}
    .ev .txt{flex:1;min-width:0}
    .ev .t1{display:block;font-weight:800;font-size:15px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .ev .t2{display:block;font-size:13px;color:var(--ink-muted);font-weight:700;margin-top:1px}
    .ev .live{color:var(--feed-dk);font-weight:800;font-variant-numeric:tabular-nums}
    .ev.sleep .live{color:var(--sleep-dk)}
    .ev .badge{flex-shrink:0;font-size:10.5px;font-weight:900;text-transform:uppercase;letter-spacing:.05em;color:#fff;padding:4px 9px;border-radius:999px}
    .ev.sleep .badge{background:var(--sleep-dk)}.ev.feed .badge{background:var(--feed-dk)}
    .ev .del{background:none;border:none;color:var(--ink-muted);cursor:pointer;font-size:16px;padding:6px;opacity:.45;flex-shrink:0;border-radius:8px;line-height:1}
    .ev .del:hover{opacity:1;background:rgba(61,46,32,.06)}
    .privacy{display:flex;gap:7px;align-items:center;justify-content:center;color:var(--ink-muted);font-size:12.5px;font-weight:700;margin-top:16px}

    .app-cta{background:var(--surface);border-radius:22px;box-shadow:var(--shadow);padding:26px;margin:26px 0;text-align:center}
    .app-cta h2{font-size:22px;font-weight:900;margin-bottom:8px}
    .app-cta p{color:var(--ink-muted);margin-bottom:18px}
    .compare{width:100%;border-collapse:collapse;margin-top:8px;font-size:15px;background:var(--surface);border-radius:16px;overflow:hidden;box-shadow:var(--shadow)}
    .compare th,.compare td{text-align:left;padding:12px 14px;border-bottom:1px solid var(--divider)}
    .compare tr:last-child td{border-bottom:none}
    .compare th{font-weight:800;color:var(--ink-muted);font-size:12px;letter-spacing:.06em;text-transform:uppercase}
    .compare td.c{text-align:center;font-weight:800}
    h2.sec{font-size:24px;font-weight:900;margin:34px 0 14px}
    .email{background:linear-gradient(160deg,#FBF1DA,#FCEBCE);border-radius:22px;padding:28px 24px;margin:26px 0;text-align:center}
    .email h2{font-size:22px;font-weight:900;margin-bottom:8px}
    .email p{color:var(--ink-muted);margin-bottom:18px;max-width:44ch;margin-left:auto;margin-right:auto}
    .email form{display:flex;gap:10px;max-width:440px;margin:0 auto;flex-wrap:wrap;justify-content:center}
    .email input[type=email],.email input[type=text]{flex:1;min-width:170px;min-height:54px;padding:0 16px;font-family:inherit;font-size:1.02rem;font-weight:600;background:#fff;border:2px solid var(--divider);border-radius:14px}
    .email input:focus{outline:none;border-color:var(--honey)}
    .email .msg{margin-top:14px;font-weight:700;min-height:22px}
    .email .msg.ok{color:#2f8f5b}.email .msg.err{color:#c0563f}
    .faq details{background:var(--surface);border-radius:14px;box-shadow:var(--shadow);padding:4px 18px;margin-bottom:12px}
    .faq summary{font-weight:800;padding:14px 0;cursor:pointer;list-style:none}
    .faq summary::-webkit-details-marker{display:none}
    .faq details[open] summary{color:var(--honey-dk)}
    .faq p{padding:0 0 16px;color:var(--ink-muted)}
    .links a{display:inline-block;margin:4px 10px 4px 0;font-weight:800}
    footer{border-top:1px solid var(--divider);padding:34px 0;text-align:center;color:var(--ink-muted);font-size:14px;margin-top:20px}
    @media(max-width:820px){.nav-links{display:none}.nav-toggle{display:flex}}
    @media(max-width:600px){.nav-cta a:first-child{display:none}}
    @media(max-width:440px){
      .wrap{padding:0 12px}
      .phone{border-radius:26px;padding:12px 10px 16px;box-shadow:0 12px 34px rgba(61,46,32,.16),0 0 0 6px #fff,0 0 0 7px var(--divider)}
      .log-btn{min-height:92px;border-radius:18px;font-size:.98rem}
      .log-btn .ic{font-size:27px}
    }
  </style>
</head>
<body>
  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href="/mamabee"><img src="/mamabee/assets/bee.png" alt="" width="42" height="42" />MamaBee</a>
      <nav class="nav-links">
        <a href="/mamabee/#how">How it works</a>
        <a href="/mamabee/#features">Features</a>
        <a href="/mamabee/#ai">AI</a>
        <a href="/mamabee/#faq">FAQ</a>
        <a href="/mamabee/tools">Free tools</a>
        <a href="/mamabee/articles">Articles</a>
      </nav>
      <div class="nav-cta">
        <a class="btn" href={appUrl} target="_blank" rel="noopener" style="min-height:44px;padding:0 20px">Get the app</a>
        <button class="nav-toggle" id="mbToggle" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
      </div>
    </div>
  </header>
  <MamaBeeMobileNav />

  <section class="wrap">
    <div class="hero">
      <div class="eyebrow">Free Demo · MamaBee</div>
      <h1>Try MamaBee in your browser</h1>
      <p class="sub">Tap to log a sleep, feed or diaper and watch your baby’s day appear on a live timeline. No sign-up — and your data never leaves this device.</p>
    </div>

    <div class="phone" id="tracker">
      <div class="phone-top">
        <div class="avatar"><img src="/mamabee/assets/bee.png" alt="" width="26" height="26" /></div>
        <div class="who"><b>Baby</b><span>Demo tracker</span></div>
        <div class="day" id="dayLabel"></div>
      </div>

      <div class="insight" id="insight">
        <img src="/mamabee/assets/bee.png" alt="" width="24" height="24" />
        <span id="insightText">Tap a button below to log your first moment. 🐝</span>
      </div>

      <div class="btn-grid">
        <button class="log-btn sleep" id="btnSleep" aria-label="Log sleep">
          <span class="ic">😴</span><span>Sleep</span><span class="st" id="stSleep"></span>
        </button>
        <button class="log-btn feed" id="btnFeed" aria-label="Log feed">
          <span class="ic">🍼</span><span>Feed</span><span class="st" id="stFeed"></span>
        </button>
        <button class="log-btn diaper" id="btnDiaper" aria-label="Log diaper">
          <span class="ic">💧</span><span>Diaper</span><span class="st"></span>
        </button>
      </div>

      <div class="subrow" id="feedRow">
        <button class="chip" data-feed="left">Left ▶</button>
        <button class="chip" data-feed="right">Right ▶</button>
        <button class="chip" data-feed="bottle">Bottle</button>
      </div>
      <div class="subrow" id="diaperRow">
        <button class="chip" data-diaper="Wet">💧 Wet</button>
        <button class="chip" data-diaper="Dirty">💩 Dirty</button>
        <button class="chip" data-diaper="Mixed">🌗 Mixed</button>
      </div>

      <div class="tl-head">
        <h2>Today</h2>
        <button id="clearBtn" hidden>Clear</button>
      </div>
      <ul class="timeline" id="timeline"><li class="empty">Nothing logged yet — give it a tap above. 👆</li></ul>

      <div class="privacy">🔒 Saved only in this browser — nothing is uploaded.</div>
    </div>

    <div class="app-cta">
      <h2>This is just a taste 🍯</h2>
      <p>The MamaBee app remembers everything, predicts naps automatically, answers your 3 AM questions with AI, and syncs with your partner — free to start.</p>
      <a class="btn" href={appUrl} target="_blank" rel="noopener">Get MamaBee — free</a>
    </div>

    <h2 class="sec">Demo vs. the full app</h2>
    <div style="overflow-x:auto;-webkit-overflow-scrolling:touch">
    <table class="compare">
      <thead><tr><th>Feature</th><th class="c">This demo</th><th class="c">MamaBee app</th></tr></thead>
      <tbody>
        <tr><td>One-tap logging</td><td class="c">✅</td><td class="c">✅</td></tr>
        <tr><td>Live daily timeline</td><td class="c">✅</td><td class="c">✅</td></tr>
        <tr><td>Data stays on your device</td><td class="c">✅</td><td class="c">✅</td></tr>
        <tr><td>Saved &amp; backed up</td><td class="c">—</td><td class="c">✅</td></tr>
        <tr><td>Sleep Coach nap prediction</td><td class="c">—</td><td class="c">✅</td></tr>
        <tr><td>Bee AI 3 AM answers</td><td class="c">—</td><td class="c">✅</td></tr>
        <tr><td>Co-parent sync</td><td class="c">—</td><td class="c">✅</td></tr>
        <tr><td>Growth charts &amp; milestones</td><td class="c">—</td><td class="c">✅</td></tr>
      </tbody>
    </table>
    </div>

    <div class="email">
      <h2>Get your baby’s free sleep cheat-sheet 🐝</h2>
      <p>Enter your email for a printable wake-windows &amp; sample-schedule cheat-sheet, plus a few genuinely helpful sleep tips.</p>
      <form id="emailForm">
        <input type="text" id="nameInput" placeholder="First name (optional)" aria-label="First name" autocomplete="given-name" />
        <input type="email" id="emailInput" placeholder="you@email.com" required aria-label="Email address" autocomplete="email" />
        <button class="btn" type="submit" id="emailBtn">Send it to me</button>
      </form>
      <div class="msg" id="emailMsg" role="status"></div>
    </div>

    <h2 class="sec">Frequently asked questions</h2>
    <div class="faq">
      {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <div class="links" style="margin:26px 0">
      <strong style="display:block;margin-bottom:8px">Keep exploring:</strong>
      <a href="/mamabee/tools">🧰 Free tools →</a>
      <a href="/mamabee/articles/day-with-mamabee-baby-tracker">📖 A day with MamaBee →</a>
      <a href="/mamabee/articles/newborn-sleep-schedule">🌙 Newborn sleep schedule →</a>
    </div>
  </section>

  <footer>Free demo · <a href="/mamabee">MamaBee</a> — the calm, AI-powered baby tracker · <a href="/">Realm Labs Studio</a><br />
    <span style="font-size:13px">A simplified taste of the app. Not medical advice — always follow your baby’s cues and your pediatrician.</span>
  </footer>

  <script is:inline>
    (function () {
      var KEY = 'mamabee_try_v1';
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      var fmtTime = function (ms) { var d = new Date(ms); var h = d.getHours(), m = d.getMinutes(); var ap = h < 12 ? 'AM' : 'PM'; var h12 = h % 12 || 12; return h12 + ':' + pad(m) + ' ' + ap; };
      var fmtDur = function (ms) { var s = Math.floor(ms / 1000); var h = Math.floor(s / 3600); var m = Math.floor((s % 3600) / 60); var ss = s % 60; if (h > 0) return h + 'h ' + m + 'm'; if (m > 0) return m + 'm ' + pad(ss) + 's'; return ss + 's'; };
      var sameDay = function (ms) { var d = new Date(ms), n = new Date(); return d.getFullYear() === n.getFullYear() && d.getMonth() === n.getMonth() && d.getDate() === n.getDate(); };
      var buzz = function () { if (navigator.vibrate) { try { navigator.vibrate(12); } catch (e) {} } };

      var events = [];
      try { events = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { events = []; }
      var save = function () { try { localStorage.setItem(KEY, JSON.stringify(events)); } catch (e) {} };

      // First visit: seed a friendly sample morning so the timeline isn't empty.
      // Skipped forever once the visitor has interacted or cleared.
      var SEED = 'mamabee_try_seeded';
      if (events.length === 0 && !localStorage.getItem(SEED)) {
        var d = new Date(); d.setSeconds(0, 0);
        var at = function (h, m) { var x = new Date(d); x.setHours(h, m, 0, 0); return x.getTime(); };
        var sid = 0, mk = function (type, sub, s, e) { return { id: 'seed' + (sid++), type: type, sub: sub, start: s, end: e === undefined ? s : e }; };
        events = [
          mk('sleep', null, at(7, 5), at(8, 40)),
          mk('feed', 'left', at(8, 50), at(9, 4)),
          mk('diaper', 'Wet', at(9, 10)),
          mk('sleep', null, at(10, 30), at(11, 15)),
          mk('feed', 'bottle', at(11, 30)),
        ].filter(function (ev) { return ev.start <= Date.now(); }); // only show past times
        save(); localStorage.setItem(SEED, '1');
      }

      var $ = function (id) { return document.getElementById(id); };
      var timelineEl = $('timeline'), clearBtn = $('clearBtn');
      var feedRow = $('feedRow'), diaperRow = $('diaperRow');

      var dl = $('dayLabel'); if (dl) dl.textContent = new Date().toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' });

      function activeOf(type, sub) { for (var i = 0; i < events.length; i++) { var e = events[i]; if (e.type === type && e.end == null && (!sub || e.sub === sub)) return e; } return null; }
      function labelFor(e) {
        if (e.type === 'sleep') return 'Sleep';
        if (e.type === 'feed') { if (e.sub === 'bottle') return 'Bottle feed'; return 'Breastfeed · ' + (e.sub === 'left' ? 'Left' : 'Right'); }
        if (e.type === 'diaper') return 'Diaper · ' + e.sub;
        return 'Event';
      }
      function iconFor(t) { return t === 'sleep' ? '😴' : t === 'feed' ? '🍼' : '💧'; }
      function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

      function nextNapHint() {
        var lastWake = null;
        for (var i = 0; i < events.length; i++) { var e = events[i]; if (e.type === 'sleep' && e.end != null) { if (lastWake == null || e.end > lastWake) lastWake = e.end; } }
        if (lastWake == null) return null;
        return lastWake + 2 * 3600 * 1000;
      }

      function render() {
        var todays = events.filter(function (e) { return sameDay(e.start); }).sort(function (a, b) { return b.start - a.start; });
        if (todays.length === 0) {
          timelineEl.innerHTML = '<li class="empty">Nothing logged yet — give it a tap above. 👆</li>';
          clearBtn.hidden = true;
        } else {
          clearBtn.hidden = false;
          timelineEl.innerHTML = '';
          todays.forEach(function (e) {
            var li = document.createElement('li'); li.className = 'ev ' + e.type;
            var running = e.end == null && (e.type === 'sleep' || e.type === 'feed');
            var t2;
            if (e.type === 'diaper' || e.sub === 'bottle') t2 = fmtTime(e.start);
            else if (running) t2 = 'Started ' + fmtTime(e.start) + ' · <span class="live" data-live="' + e.id + '">' + fmtDur(Date.now() - e.start) + '</span>';
            else t2 = fmtTime(e.start) + ' – ' + fmtTime(e.end) + ' · ' + fmtDur(e.end - e.start);
            var badge = running ? '<span class="badge">Live</span>' : '';
            li.innerHTML =
              '<span class="dot">' + iconFor(e.type) + '</span>' +
              '<span class="txt"><span class="t1">' + esc(labelFor(e)) + '</span><span class="t2">' + t2 + '</span></span>' +
              badge +
              '<button class="del" data-del="' + e.id + '" aria-label="Delete">✕</button>';
            timelineEl.appendChild(li);
          });
        }
        var sl = activeOf('sleep'); $('btnSleep').classList.toggle('running', !!sl); $('stSleep').textContent = sl ? 'tap to stop' : '';
        var fd = activeOf('feed'); var fdTimer = fd && fd.sub !== 'bottle'; $('btnFeed').classList.toggle('running', !!fdTimer); $('stFeed').textContent = fdTimer ? 'tap to stop' : '';
        var hint = nextNapHint(); var it = $('insightText');
        if (sl) it.textContent = 'Sleep in progress — tap 😴 again when baby wakes.';
        else if (fdTimer) it.textContent = 'Feed in progress — tap the same side again to stop.';
        else if (hint) it.innerHTML = 'Based on the last wake, the next nap is likely around <strong>' + fmtTime(hint) + '</strong>. <span style="opacity:.65">The app predicts this for you.</span>';
        else if (todays.length) it.textContent = 'Nice — keep logging and MamaBee starts spotting patterns. 🐝';
        else it.textContent = 'Tap a button below to log your first moment. 🐝';
      }

      setInterval(function () {
        document.querySelectorAll('[data-live]').forEach(function (n) { var id = n.getAttribute('data-live'); var e = events.filter(function (x) { return x.id === id; })[0]; if (e && e.end == null) n.textContent = fmtDur(Date.now() - e.start); });
      }, 1000);

      function newId() { return 'e' + Date.now() + Math.floor(performance.now() % 1000); }
      function addInstant(type, sub) { events.push({ id: newId(), type: type, sub: sub, start: Date.now(), end: Date.now() }); save(); render(); buzz(); }
      function toggleTimer(type, sub) { var a = activeOf(type, type === 'feed' ? sub : null); if (a) a.end = Date.now(); else events.push({ id: newId(), type: type, sub: sub || null, start: Date.now(), end: null }); save(); render(); buzz(); }

      $('btnSleep').addEventListener('click', function () { feedRow.classList.remove('show'); diaperRow.classList.remove('show'); toggleTimer('sleep'); });
      $('btnFeed').addEventListener('click', function () { diaperRow.classList.remove('show'); var r = activeOf('feed'); if (r && r.sub !== 'bottle') { toggleTimer('feed', r.sub); feedRow.classList.remove('show'); return; } feedRow.classList.toggle('show'); });
      $('btnDiaper').addEventListener('click', function () { feedRow.classList.remove('show'); diaperRow.classList.toggle('show'); });
      feedRow.addEventListener('click', function (ev) { var b = ev.target.closest('[data-feed]'); if (!b) return; var sub = b.getAttribute('data-feed'); if (sub === 'bottle') addInstant('feed', 'bottle'); else toggleTimer('feed', sub); feedRow.classList.remove('show'); });
      diaperRow.addEventListener('click', function (ev) { var b = ev.target.closest('[data-diaper]'); if (!b) return; addInstant('diaper', b.getAttribute('data-diaper')); diaperRow.classList.remove('show'); });
      timelineEl.addEventListener('click', function (ev) { var b = ev.target.closest('[data-del]'); if (!b) return; var id = b.getAttribute('data-del'); events = events.filter(function (e) { return e.id !== id; }); save(); render(); });
      clearBtn.addEventListener('click', function () { if (confirm('Clear all logged moments? This only affects this browser.')) { events = []; save(); localStorage.setItem(SEED, '1'); render(); } });

      render();

      var form = $('emailForm');
      if (form) form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = $('emailInput').value.trim(), name = $('nameInput').value.trim();
        var msg = $('emailMsg'), btn = $('emailBtn');
        msg.className = 'msg'; msg.textContent = 'Sending…'; btn.disabled = true;
        fetch('/api/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email, name: name, source: 'try_demo' }) })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) { if (res.ok) { msg.className = 'msg ok'; msg.innerHTML = '🎉 You’re in! Grab your cheat-sheet → <a href="/mamabee/baby-sleep-cheat-sheet">Open it</a>'; form.reset(); } else { msg.className = 'msg err'; msg.textContent = (res.d && res.d.error) || 'Something went wrong. Please try again.'; } })
          .catch(function () { msg.className = 'msg err'; msg.textContent = 'Something went wrong. Please try again.'; })
          .finally(function () { btn.disabled = false; });
      });
    })();
  </script>
</body>
</html>
