---
import { MAMABEE_TOOLS } from '../../../data/mamabeeTools';
import MamaBeeMobileNav from '../../../components/MamaBeeMobileNav.astro';
const title = 'Free Baby Tools & Calculators — Wake Windows, Feeding & Sleep | MamaBee';
const description = 'Free, instant baby calculators from MamaBee: wake window calculator, sleep schedule generator, feeding calculator, and due date calculator. No sign-up needed.';
const canonical = 'https://www.realmlabs.app/mamabee/tools';
const appUrl = 'https://apps.apple.com/us/app/mamabee-baby-tracker/id6773179521';
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: MAMABEE_TOOLS.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: `https://www.realmlabs.app/mamabee/tools/${t.slug}`,
  })),
};
---
<!DOCTYPE html>
<html lang="en" data-mood="golden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/mamabee/assets/bee.png" />
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <style>
    :root{--honey:#F0B040;--honey-dk:#D89A2E;--cream:#FCEBCE;--cream-tint:#FBF1DA;--surface:#fff;--ink:#3D2E20;--ink-muted:#8A7A68;--divider:#F0E6D6;--cocoa:#643018;--shadow:0 10px 30px rgba(61,46,32,.1)}
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:"Nunito",system-ui,sans-serif;background:var(--cream);color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.6}
    a{color:var(--honey-dk)}
    .nav{position:sticky;top:0;z-index:50;background:rgba(252,235,206,.9);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--divider)}
    .nav-inner{max-width:1120px;margin:0 auto;display:flex;align-items:center;gap:20px;height:74px;padding:0 24px}
    .brand{display:inline-flex;align-items:center;gap:12px;font-weight:900;font-size:1.4rem;letter-spacing:-.02em;color:var(--ink);text-decoration:none}
    .brand img{width:46px;height:46px}
    .nav-links{display:flex;gap:8px;margin-left:12px}
    .nav-links a{font-weight:800;font-size:1rem;color:var(--ink-muted);padding:9px 15px;border-radius:12px;text-decoration:none;transition:color .16s,background-color .16s}
    .nav-links a:hover,.nav-links a[aria-current]{color:#643018;background:#FDF1D2}
    .nav-cta{margin-left:auto;display:flex;align-items:center;gap:14px}
    .btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;font-size:.98rem;border-radius:15px;font-weight:800;text-decoration:none;background:linear-gradient(160deg,#F6C158,#E7A636);color:var(--cocoa);box-shadow:0 5px 0 #B97E1F,0 4px 16px rgba(61,46,32,.07);transition:filter .16s,transform .06s}
    .btn:hover{filter:brightness(1.02)}
    .btn:active{transform:translateY(4px);box-shadow:0 1px 0 #B97E1F}
    @media(max-width:760px){.nav-links{display:none}.nav-inner{height:62px;gap:12px;padding:0 16px}.brand{font-size:1.2rem}.brand img{width:38px;height:38px}.nav-cta .btn{min-height:42px;padding:0 16px;font-size:.9rem}}
    .wrap{max-width:1120px;margin:0 auto;padding:0 24px}
    .hero{text-align:center;padding:60px 0 34px}
    .eyebrow{font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--honey-dk)}
    h1{font-size:clamp(32px,5vw,48px);font-weight:900;margin:14px 0 12px;letter-spacing:-.02em;text-wrap:balance}
    .sub{color:var(--ink-muted);font-size:18px;max-width:600px;margin:0 auto}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:22px;padding:8px 0 30px}
    .tool{background:var(--surface);border-radius:22px;box-shadow:var(--shadow);padding:26px 26px 22px;display:flex;flex-direction:column}
    .tool .ico{font-size:34px;line-height:1}
    .tool h2{font-size:21px;font-weight:900;margin:12px 0 6px;letter-spacing:-.01em}
    .tool h2 a{color:var(--ink);text-decoration:none}
    .tool h2 a:hover{color:var(--honey-dk)}
    .tool .tag{color:var(--ink-muted);font-size:15px;margin-bottom:14px}
    .tool .for{font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--honey-dk);margin-bottom:16px}
    .tool .open{margin-top:auto;font-weight:800;color:var(--cocoa);background:var(--cream-tint);border:1px solid var(--divider);border-radius:13px;padding:12px 16px;text-align:center;text-decoration:none;transition:background-color .16s}
    .tool .open:hover{background:#FCE7B5}
    .reads{border-top:1px solid var(--divider);margin-top:18px;padding-top:14px}
    .reads .lbl{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-muted);margin-bottom:8px}
    .reads a{display:block;font-size:14px;font-weight:700;color:var(--honey-dk);text-decoration:none;padding:3px 0}
    .reads a:hover{text-decoration:underline}
    .app{background:var(--surface);border-radius:22px;box-shadow:var(--shadow);padding:30px 26px;margin:14px 0 70px;text-align:center}
    .app h2{font-size:23px;font-weight:900;margin-bottom:8px}
    .app p{color:var(--ink-muted);margin-bottom:18px;max-width:52ch;margin-left:auto;margin-right:auto}
    footer{border-top:1px solid var(--divider);padding:32px 0;text-align:center;color:var(--ink-muted);font-size:14px}
  </style>
</head>
<body>
  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href="/mamabee/"><img src="/mamabee/assets/bee.png" alt="" width="46" height="46" />MamaBee</a>
      <nav class="nav-links">
        <a href="/mamabee/#how">How it works</a>
        <a href="/mamabee/#features">Features</a>
        <a href="/mamabee/#ai">AI</a>
        <a href="/mamabee/#faq">FAQ</a>
        <a href="/mamabee/tools" aria-current="page">Free tools</a>
        <a href="/mamabee/articles">Articles</a>
      </nav>
      <div class="nav-cta">
        <a class="btn" href={appUrl} target="_blank" rel="noopener">Get the app</a>
        <button class="nav-toggle" id="mbToggle" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
      </div>
    </div>
  </header>
  <MamaBeeMobileNav />

  <section class="wrap">
    <div class="hero">
      <div class="eyebrow">Free MamaBee Tools</div>
      <h1>Free baby calculators — no sign-up, instant answers</h1>
      <p class="sub">Quick, honest tools for the questions every new parent Googles at 2 AM. Free to use, no account needed.</p>
    </div>

    <div class="grid">
      {MAMABEE_TOOLS.map((t) => (
        <div class="tool">
          <div class="ico">{t.emoji}</div>
          <h2><a href={`/mamabee/tools/${t.slug}`}>{t.name}</a></h2>
          <div class="for">For: {t.forWho}</div>
          <p class="tag">{t.tagline}</p>
          <a class="open" href={`/mamabee/tools/${t.slug}`}>Open the {t.name} →</a>
          <div class="reads">
            <div class="lbl">Helpful reads</div>
            {t.articles.map((a) => (
              <a href={`/mamabee/articles/${a.slug}`}>{a.title}</a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="app">
      <h2>Tired of doing the math yourself?</h2>
      <p>MamaBee logs feeds, sleep, and diapers with one thumb — then calculates wake windows and predicts the next nap automatically. The calm, AI-powered baby tracker.</p>
      <a class="btn" href={appUrl} target="_blank" rel="noopener">Get MamaBee — free</a>
    </div>
  </section>

  <footer>© MamaBee · Made with honey by parents · <a href="/mamabee/articles">Articles</a> · <a href="/">Realm Labs</a></footer>
</body>
</html>
