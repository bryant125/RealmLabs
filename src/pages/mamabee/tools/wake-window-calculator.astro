---
const title = 'Baby Wake Window Calculator — Free Nap Timing Tool | MamaBee';
const description = 'Free baby wake window calculator: enter your baby’s age and last wake-up time to get the ideal next nap window instantly. Stop guessing nap times and beat the overtired meltdown.';
const canonical = 'https://www.realmlabs.app/mamabee/tools/wake-window-calculator';
const appUrl = 'https://apps.apple.com/us/app/mamabee-baby-tracker/id6773179521';
const faq = [
  { q: 'What is a wake window?', a: 'A wake window is how long your baby can comfortably stay awake — feed and play included — before they need to sleep again. Timing sleep near the end of the window helps your baby fall asleep easily and avoid becoming overtired.' },
  { q: 'How accurate is a wake window calculator?', a: 'It gives you a reliable starting range based on your baby’s age. Every baby is a little different, so watch your baby’s sleepy cues (yawning, red eyebrows, staring) and adjust by 10–15 minutes as needed.' },
  { q: 'What happens if I miss my baby’s wake window?', a: 'An overtired baby often fights sleep harder and wakes more at night. If you miss the window, extra soothing — motion, a dark room, contact — helps them settle.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const appSchema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Baby Wake Window Calculator', applicationCategory: 'HealthApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, url: canonical };
---
<!DOCTYPE html>
<html lang="en" data-mood="golden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/mamabee/assets/bee.png" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <style>
    :root{--honey:#F0B040;--honey-dk:#D89A2E;--cream:#FCEBCE;--cream-tint:#FBF1DA;--surface:#fff;--ink:#3D2E20;--ink-muted:#8A7A68;--divider:#F0E6D6;--cocoa:#643018;--shadow:0 10px 30px rgba(61,46,32,.1)}
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:"Nunito",system-ui,sans-serif;background:var(--cream);color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.6}
    a{color:var(--honey-dk)}
    .nav{position:sticky;top:0;z-index:50;background:rgba(252,235,206,.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--divider)}
    .nav-inner{max-width:1000px;margin:0 auto;display:flex;align-items:center;gap:20px;height:70px;padding:0 22px}
    .brand{display:inline-flex;align-items:center;gap:11px;font-weight:900;font-size:1.35rem;color:var(--ink);text-decoration:none;letter-spacing:-.02em}
    .brand img{width:42px;height:42px}
    .nav-cta{margin-left:auto;display:flex;gap:14px;align-items:center}
    .nav-cta a{font-weight:800;color:var(--ink-muted);text-decoration:none;font-size:.95rem}
    .btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 26px;border-radius:15px;font-weight:800;font-family:"Nunito",sans-serif;font-size:1rem;text-decoration:none;border:none;cursor:pointer;background:linear-gradient(160deg,#F6C158,#E7A636);color:var(--cocoa);box-shadow:0 5px 0 #B97E1F,var(--shadow);transition:filter .16s,transform .06s}
    .btn:hover{filter:brightness(1.03)}
    .btn:active{transform:translateY(4px);box-shadow:0 1px 0 #B97E1F}
    .wrap{max-width:720px;margin:0 auto;padding:0 22px}
    .hero{text-align:center;padding:52px 0 20px}
    .eyebrow{font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--honey-dk)}
    h1{font-size:clamp(30px,5.5vw,44px);font-weight:900;line-height:1.1;letter-spacing:-.02em;margin:12px 0 12px;text-wrap:balance}
    .sub{color:var(--ink-muted);font-size:18px;max-width:52ch;margin:0 auto}
    .card{background:var(--surface);border-radius:26px;box-shadow:var(--shadow);padding:30px 28px;margin:26px 0}
    .field{margin-bottom:20px}
    .field label{display:block;font-weight:800;margin-bottom:8px;font-size:.98rem}
    .field select,.field input{width:100%;min-height:54px;padding:0 16px;font-family:inherit;font-size:1.05rem;font-weight:700;color:var(--ink);background:var(--cream-tint);border:2px solid var(--divider);border-radius:14px;appearance:none}
    .field select:focus,.field input:focus{outline:none;border-color:var(--honey)}
    .calc-btn{width:100%}
    .result{display:none;margin-top:24px;background:linear-gradient(160deg,#FDF1D2,#FCE7B5);border:1px solid var(--divider);border-radius:20px;padding:26px 24px;text-align:center}
    .result.show{display:block}
    .result .lbl{font-weight:800;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--honey-dk)}
    .result .time{font-size:clamp(34px,7vw,52px);font-weight:900;color:var(--ink);margin:6px 0;letter-spacing:-.02em}
    .result .win{color:var(--ink-muted);font-weight:700}
    .result .tip{margin-top:14px;font-size:15px;color:var(--ink-muted)}
    .app-cta{background:var(--surface);border-radius:22px;box-shadow:var(--shadow);padding:26px;margin:26px 0;text-align:center}
    .app-cta h2{font-size:22px;font-weight:900;margin-bottom:8px}
    .app-cta p{color:var(--ink-muted);margin-bottom:18px}
    .email{background:linear-gradient(160deg,#FBF1DA,#FCEBCE);border-radius:22px;padding:28px 24px;margin:26px 0;text-align:center}
    .email h2{font-size:22px;font-weight:900;margin-bottom:8px}
    .email p{color:var(--ink-muted);margin-bottom:18px;max-width:44ch;margin-left:auto;margin-right:auto}
    .email form{display:flex;gap:10px;max-width:440px;margin:0 auto;flex-wrap:wrap;justify-content:center}
    .email input[type=email],.email input[type=text]{flex:1;min-width:170px;min-height:54px;padding:0 16px;font-family:inherit;font-size:1.02rem;font-weight:600;background:#fff;border:2px solid var(--divider);border-radius:14px}
    .email input:focus{outline:none;border-color:var(--honey)}
    .email .msg{margin-top:14px;font-weight:700;min-height:22px}
    .email .msg.ok{color:#2f8f5b}.email .msg.err{color:#c0563f}
    table.ref{width:100%;border-collapse:collapse;margin-top:8px;font-size:15px}
    table.ref th,table.ref td{text-align:left;padding:11px 12px;border-bottom:1px solid var(--divider)}
    table.ref th{font-weight:800;color:var(--ink-muted);font-size:12px;letter-spacing:.06em;text-transform:uppercase}
    h2.sec{font-size:24px;font-weight:900;margin:34px 0 14px}
    .prose p{margin:0 0 14px;color:var(--ink)}
    .faq details{background:var(--surface);border-radius:14px;box-shadow:var(--shadow);padding:4px 18px;margin-bottom:12px}
    .faq summary{font-weight:800;padding:14px 0;cursor:pointer;list-style:none}
    .faq summary::-webkit-details-marker{display:none}
    .faq details[open] summary{color:var(--honey-dk)}
    .faq p{padding:0 0 16px;color:var(--ink-muted)}
    .links a{display:inline-block;margin:4px 10px 4px 0;font-weight:800}
    footer{border-top:1px solid var(--divider);padding:34px 0;text-align:center;color:var(--ink-muted);font-size:14px;margin-top:20px}
    @media(max-width:600px){.nav-cta a:first-child{display:none}}
  </style>
</head>
<body>
  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href="/mamabee/"><img src="/mamabee/assets/bee.png" alt="" width="42" height="42" />MamaBee</a>
      <div class="nav-cta">
        <a href="/mamabee/articles">Articles</a>
        <a class="btn" href={appUrl} target="_blank" rel="noopener" style="min-height:44px;padding:0 20px">Get the app</a>
      </div>
    </div>
  </header>

  <section class="wrap">
    <div class="hero">
      <div class="eyebrow">Free Tool · MamaBee</div>
      <h1>Baby Wake Window Calculator</h1>
      <p class="sub">Enter your baby’s age and when they last woke up — get the ideal next nap window instantly, and beat the overtired meltdown.</p>
    </div>

    <div class="card">
      <div class="field">
        <label for="age">Your baby’s age</label>
        <select id="age">
          <option value="35,60">Newborn (0–1 month)</option>
          <option value="45,90">1–2 months</option>
          <option value="75,120" selected>3–4 months</option>
          <option value="120,150">5–6 months</option>
          <option value="150,210">7–9 months</option>
          <option value="180,240">10–12 months</option>
        </select>
      </div>
      <div class="field">
        <label for="wake">Time baby last woke up</label>
        <input type="time" id="wake" />
      </div>
      <button class="btn calc-btn" id="calc">Calculate next nap →</button>

      <div class="result" id="result">
        <div class="lbl">Aim to start the next nap around</div>
        <div class="time" id="napTime">—</div>
        <div class="win" id="napWin"></div>
        <div class="tip">Watch for sleepy cues near this window — yawning, red eyebrows, or a faraway stare — and start winding down <em>before</em> your baby gets overtired.</div>
      </div>
    </div>

    <div class="app-cta">
      <h2>Tired of doing nap math?</h2>
      <p>MamaBee predicts every nap automatically from your baby’s real sleep — no calculator needed.</p>
      <a class="btn" href={appUrl} target="_blank" rel="noopener">Get MamaBee — free</a>
    </div>

    <div class="email">
      <h2>Get your baby’s free sleep cheat-sheet 🐝</h2>
      <p>Enter your email and we’ll send you a printable wake-windows &amp; sample-schedule cheat-sheet, plus a few genuinely helpful sleep tips.</p>
      <form id="emailForm">
        <input type="text" id="nameInput" placeholder="First name (optional)" aria-label="First name" autocomplete="given-name" />
        <input type="email" id="emailInput" placeholder="you@email.com" required aria-label="Email address" autocomplete="email" />
        <button class="btn" type="submit" id="emailBtn">Send it to me</button>
      </form>
      <div class="msg" id="emailMsg" role="status"></div>
    </div>

    <h2 class="sec">Wake windows by age (reference)</h2>
    <table class="ref">
      <thead><tr><th>Age</th><th>Wake window</th></tr></thead>
      <tbody>
        <tr><td>0–1 month</td><td>35–60 minutes</td></tr>
        <tr><td>1–2 months</td><td>45–90 minutes</td></tr>
        <tr><td>3–4 months</td><td>75–120 minutes</td></tr>
        <tr><td>5–6 months</td><td>2–2.5 hours</td></tr>
        <tr><td>7–9 months</td><td>2.5–3.5 hours</td></tr>
        <tr><td>10–12 months</td><td>3–4 hours</td></tr>
      </tbody>
    </table>

    <h2 class="sec">How to use the wake window calculator</h2>
    <div class="prose">
      <p>Pick your baby’s age to load their typical wake window, enter the time they last woke up, and the calculator adds the wake window to that time to show when the next nap should start. Use it as a reliable starting point, then fine-tune to your own baby with their sleepy cues.</p>
      <p>Want the full picture? Read our <a href="/mamabee/articles/wake-windows-by-age">wake windows by age guide</a>, the <a href="/mamabee/articles/newborn-sleep-schedule">newborn sleep schedule</a>, and how to build a calming <a href="/mamabee/articles/baby-bedtime-routine">baby bedtime routine</a>.</p>
    </div>

    <h2 class="sec">Frequently asked questions</h2>
    <div class="faq">
      {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <div class="links" style="margin:26px 0">
      <strong style="display:block;margin-bottom:8px">Keep reading:</strong>
      <a href="/mamabee/articles/wake-windows-by-age">Wake Windows by Age →</a>
      <a href="/mamabee/articles/newborn-sleep-schedule">Newborn Sleep Schedule →</a>
      <a href="/mamabee/articles/4-month-sleep-regression">4-Month Sleep Regression →</a>
    </div>
  </section>

  <footer>Free tool · <a href="/mamabee/">MamaBee</a> — the calm, AI-powered baby tracker · <a href="/">Realm Labs</a><br />
    <span style="font-size:13px">Not medical advice — a helpful guide, always follow your baby’s cues and your pediatrician.</span>
  </footer>

  <script is:inline>
    (function () {
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      var fmt = function (mins) {
        mins = ((mins % 1440) + 1440) % 1440;
        var h = Math.floor(mins / 60), m = mins % 60;
        var ap = h < 12 ? 'AM' : 'PM'; var h12 = h % 12; if (h12 === 0) h12 = 12;
        return h12 + ':' + pad(m) + ' ' + ap;
      };
      var wakeEl = document.getElementById('wake');
      var now = new Date(); wakeEl.value = pad(now.getHours()) + ':' + pad(now.getMinutes());
      document.getElementById('calc').addEventListener('click', function () {
        var w = wakeEl.value; if (!w) { wakeEl.focus(); return; }
        var parts = w.split(':'); var base = parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
        var win = document.getElementById('age').value.split(',');
        var lo = base + parseInt(win[0], 10), hi = base + parseInt(win[1], 10);
        var mid = Math.round((lo + hi) / 2);
        document.getElementById('napTime').textContent = fmt(mid);
        document.getElementById('napWin').textContent = 'Nap window: ' + fmt(lo) + ' – ' + fmt(hi);
        var r = document.getElementById('result'); r.classList.add('show');
        r.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
      var form = document.getElementById('emailForm');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = document.getElementById('emailInput').value.trim();
        var name = document.getElementById('nameInput').value.trim();
        var msg = document.getElementById('emailMsg'); var btn = document.getElementById('emailBtn');
        msg.className = 'msg'; msg.textContent = 'Sending…'; btn.disabled = true;
        fetch('/api/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email, name: name, source: 'wake_window_calculator' }) })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            if (res.ok) { msg.className = 'msg ok'; msg.innerHTML = '🎉 You’re in! Grab your cheat-sheet now → <a href="/mamabee/baby-sleep-cheat-sheet">Open it</a>'; form.reset(); }
            else { msg.className = 'msg err'; msg.textContent = (res.d && res.d.error) || 'Something went wrong. Please try again.'; }
          })
          .catch(function () { msg.className = 'msg err'; msg.textContent = 'Something went wrong. Please try again.'; })
          .finally(function () { btn.disabled = false; });
      });
    })();
  </script>
</body>
</html>
