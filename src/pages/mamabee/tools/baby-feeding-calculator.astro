---
import ToolLayout from '../../../layouts/ToolLayout.astro';
const faq = [
  { q: 'How much formula should my baby drink per day?', a: 'A common guideline is about 2 to 2.5 ounces of formula per pound of body weight per day, up to a maximum of around 32 oz/day. Every baby is different — always follow your baby’s hunger and fullness cues rather than forcing a number.' },
  { q: 'How many ounces per feeding does a baby need?', a: 'It depends on age and how often they feed. Newborns take small amounts often (1–3 oz), building to 3–4 oz by 1–2 months. This calculator divides the daily total across your chosen number of feeds as a starting estimate.' },
  { q: 'Does this work for breastfed babies?', a: 'This calculator is for formula/bottle amounts. Breastfed babies self-regulate at the breast, so intake isn’t measured in ounces — instead, watch for enough wet diapers and steady weight gain.' },
];
---
<ToolLayout
  title="Baby Formula Feeding Calculator — How Much Should Baby Eat? | MamaBee"
  description="Free baby feeding calculator: enter your baby’s weight to estimate how much formula they need per day and per feeding. A simple starting point — always follow your baby’s cues."
  canonical="https://www.realmlabs.app/mamabee/tools/baby-feeding-calculator"
  source="feeding_calculator"
  heroTitle="Baby Feeding Calculator"
  heroSub="Enter your baby’s weight to estimate how much formula they need each day and per feeding. A simple starting point — always follow your baby’s cues."
>
  <div class="card">
    <div class="field">
      <label for="weight">Your baby’s weight</label>
      <div style="display:flex;gap:10px">
        <input type="number" id="weight" min="1" step="0.1" placeholder="e.g. 9" style="flex:1" />
        <select id="unit" style="width:110px"><option value="lb" selected>lb</option><option value="kg">kg</option></select>
      </div>
    </div>
    <div class="field">
      <label for="feeds">Feeds per day</label>
      <select id="feeds">
        <option value="6">6 feeds</option><option value="7">7 feeds</option>
        <option value="8" selected>8 feeds</option><option value="9">9 feeds</option>
        <option value="10">10 feeds</option><option value="12">12 feeds</option>
      </select>
    </div>
    <button class="btn full" id="calc">Calculate feeding amount →</button>
    <div class="result" id="result">
      <div class="lbl">Estimated daily formula</div>
      <div class="big" id="daily">—</div>
      <div class="note" id="perFeed"></div>
      <div class="tip">This is a general estimate for formula-fed babies (about 2.5 oz per pound per day, capped near 32 oz). Never force a bottle — follow your baby’s hunger and fullness cues, and check with your pediatrician.</div>
    </div>
  </div>
  <script is:inline>
    (function () {
      var wEl = document.getElementById('weight');
      document.getElementById('calc').addEventListener('click', function () {
        var w = parseFloat(wEl.value); if (!w || w <= 0) { wEl.focus(); return; }
        if (document.getElementById('unit').value === 'kg') w = w * 2.20462;
        var daily = Math.min(Math.round(w * 2.5), 32);
        var feeds = parseInt(document.getElementById('feeds').value, 10);
        var per = Math.round((daily / feeds) * 2) / 2; // nearest 0.5 oz
        document.getElementById('daily').textContent = daily + ' oz / day';
        document.getElementById('perFeed').textContent = '≈ ' + per + ' oz per feed, across ' + feeds + ' feeds';
        var r = document.getElementById('result'); r.classList.add('show');
        r.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    })();
  </script>
</ToolLayout>
