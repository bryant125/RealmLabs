---
import MamaBeeFooter from '../../components/MamaBeeFooter.astro';
const title = 'Baby Sleep Cheat-Sheet (Free Printable) | MamaBee';
const description = 'Free printable baby sleep cheat-sheet: wake windows by age, sample daily schedules, sleepy cues, safe sleep ABCs, and calm-sleep tips. From tired parents, for tired parents.';
---
<!DOCTYPE html>
<html lang="en" data-mood="golden">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
<link rel="canonical" href="https://www.realmlabs.app/mamabee/baby-sleep-cheat-sheet" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<link rel="icon" type="image/png" href="/mamabee/assets/bee.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
<title>MamaBee Baby Sleep Cheat-Sheet</title>
<style>
  /* A printable freebie — deliberately committed to the warm MamaBee light look
     (it's meant to be printed on white). */
  :root{
    --cream:#FDF4E3; --card:#FFFDF8; --honey:#F0B040; --honey-dk:#D89A2E;
    --honey-deep:#B97E1F; --cocoa:#643018; --ink:#3D2E20; --ink-soft:#8A7A68;
    --line:#EFE3CD; --lav:#A89DC2; --mint:#7FC8A0; --rose:#E89AAA;
    --round:"Nunito",ui-rounded,"SF Pro Rounded",system-ui,sans-serif;
    --body:system-ui,-apple-system,"Segoe UI",sans-serif;
    --mono:ui-monospace,"SF Mono",Menlo,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:#E9DEC6;font-family:var(--body);color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.5;padding:26px 16px}
  .sheet{max-width:820px;margin:0 auto;background:var(--cream);border-radius:26px;overflow:hidden;box-shadow:0 24px 60px rgba(61,46,32,.22)}
  .pad{padding:34px 38px}
  /* header */
  .head{background:linear-gradient(160deg,#FCE7B5,#F6C158);padding:32px 38px 30px;position:relative}
  .brand{display:flex;align-items:center;gap:12px;font-family:var(--round);font-weight:900;font-size:20px;color:var(--cocoa);letter-spacing:.01em}
  .brand .bee{width:44px;height:44px;border-radius:50%;background:#fff;object-fit:contain;padding:3px;box-shadow:0 3px 8px rgba(61,46,32,.15)}
  h1{font-family:var(--round);font-weight:900;font-size:clamp(28px,5vw,40px);color:var(--cocoa);line-height:1.05;letter-spacing:-.02em;margin:16px 0 8px;text-wrap:balance}
  .head .sub{color:#7a5626;font-weight:700;font-size:16px;max-width:52ch}
  /* section */
  .sec{margin-top:30px}
  .sec-title{display:flex;align-items:center;gap:10px;font-family:var(--round);font-weight:900;font-size:20px;color:var(--ink);margin-bottom:14px}
  .sec-title .n{width:28px;height:28px;border-radius:9px;background:var(--honey);color:#fff;display:grid;place-items:center;font-size:14px;flex:none}
  /* wake window table */
  table.ww{width:100%;border-collapse:separate;border-spacing:0;background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden}
  table.ww th,table.ww td{padding:12px 16px;text-align:left;font-size:15px}
  table.ww thead th{background:#FBF1DA;font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);font-weight:700}
  table.ww tbody tr:not(:last-child) td{border-bottom:1px solid var(--line)}
  table.ww td:first-child{font-weight:800}
  table.ww td.win{color:var(--honey-deep);font-weight:800}
  /* schedule cards */
  .sched{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .sc{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 18px 14px}
  .sc .age{font-family:var(--mono);font-size:10.5px;color:var(--honey-deep);letter-spacing:.05em;text-transform:uppercase;font-weight:700}
  .sc .win{font-family:var(--round);font-weight:900;font-size:15px;color:var(--ink);margin:5px 0 4px}
  .tl{list-style:none;margin:8px 0 0}
  .tl li{display:grid;grid-template-columns:42px 1fr;gap:10px;align-items:center;padding:6px 0}
  .tl .t{font-variant-numeric:tabular-nums;font-weight:800;color:var(--honey-deep);font-size:12.5px;text-align:right}
  .tl .a{font-size:13.5px;color:var(--ink);font-weight:600;position:relative;padding-left:17px}
  .tl .a::before{content:"";position:absolute;left:0;top:50%;transform:translateY(-50%);width:8px;height:8px;border-radius:50%;background:var(--honey);box-shadow:0 0 0 3px #FBF1DA}
  .tl li.rep .a::before{background:var(--lav)}
  .tl li.bed .a::before{background:var(--cocoa)}
  /* two-column blocks */
  .cols{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .block{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 20px}
  .check{list-style:none;display:grid;gap:9px}
  .check li{display:flex;gap:10px;align-items:flex-start;font-size:14.5px;font-weight:600}
  .check li::before{content:"";width:18px;height:18px;border:2px solid var(--honey);border-radius:6px;flex:none;margin-top:1px}
  .abc{display:grid;gap:12px}
  .abc div{display:flex;gap:12px;align-items:center}
  .abc .b{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;font-family:var(--round);font-weight:900;color:#fff;font-size:18px;flex:none}
  .abc small{display:block;color:var(--ink-soft);font-weight:600;font-size:13px}
  .abc strong{font-family:var(--round);font-size:15px}
  /* tips */
  .tips{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .tip{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 16px;display:flex;gap:12px;align-items:flex-start}
  .tip .e{font-size:22px;flex:none}
  .tip p{font-size:14px}
  .tip b{font-family:var(--round)}
  /* cta */
  .cta{margin-top:30px;background:linear-gradient(160deg,#F6C158,#E7A636);border-radius:20px;padding:24px 26px;text-align:center;color:var(--cocoa)}
  .cta h2{font-family:var(--round);font-weight:900;font-size:22px;margin-bottom:6px}
  .cta p{font-weight:700;color:#7a5626;margin-bottom:16px}
  .cta a{display:inline-block;background:var(--cocoa);color:#fff;font-family:var(--round);font-weight:800;text-decoration:none;padding:13px 30px;border-radius:14px;box-shadow:0 5px 0 #4a2310}
  .foot{text-align:center;color:var(--ink-soft);font-size:12px;padding:22px 38px 30px}
  .foot .med{margin-top:6px}
  @media(max-width:640px){.sched,.cols,.tips{grid-template-columns:1fr}.pad,.head{padding-left:22px;padding-right:22px}}
  @media print{body{background:#fff;padding:0}.sheet{box-shadow:none;border-radius:0;max-width:100%}}
</style>
<style>
  .printbar{max-width:820px;margin:0 auto 16px;display:flex;justify-content:flex-end}
  .printbar button{font-family:"Nunito",sans-serif;font-weight:800;background:#fff;color:#643018;border:1px solid #EFE3CD;border-radius:12px;padding:10px 20px;cursor:pointer;box-shadow:0 6px 16px rgba(61,46,32,.1)}
  .printbar button:hover{background:#FDF4E3}
  @media print{.printbar{display:none}}
</style>
</head>
<body>
<div class="printbar"><button onclick="window.print()">🖨️ Print / Save as PDF</button></div>
<div class="sheet">
  <div class="head">
    <div class="brand"><img class="bee" src="/mamabee/assets/bee.png" alt="MamaBee logo" width="44" height="44" />MamaBee</div>
    <h1>The Baby Sleep Cheat-Sheet</h1>
    <p class="sub">Wake windows, sample schedules &amp; calm-sleep tips — from tired parents, for tired parents. Stick it on the fridge. 💛</p>
  </div>

  <div class="pad">
    <!-- 1. Wake windows -->
    <div class="sec">
      <div class="sec-title"><span class="n">1</span>Wake Windows by Age</div>
      <table class="ww">
        <thead><tr><th>Age</th><th>Awake time before next sleep</th><th>Naps / day</th></tr></thead>
        <tbody>
          <tr><td>0–1 month</td><td class="win">35–60 min</td><td>Many (4–6+)</td></tr>
          <tr><td>1–2 months</td><td class="win">45–90 min</td><td>4–5</td></tr>
          <tr><td>3–4 months</td><td class="win">75–120 min</td><td>3–4</td></tr>
          <tr><td>5–6 months</td><td class="win">2–2.5 hours</td><td>2–3</td></tr>
          <tr><td>7–9 months</td><td class="win">2.5–3.5 hours</td><td>2</td></tr>
          <tr><td>10–12 months</td><td class="win">3–4 hours</td><td>2</td></tr>
        </tbody>
      </table>
    </div>

    <!-- 2. Sample schedules -->
    <div class="sec">
      <div class="sec-title"><span class="n">2</span>Sample Daily Rhythms</div>
      <div class="sched">
        <div class="sc">
          <div class="age">Newborn · 0–3 months</div>
          <div class="win">45–60 min windows</div>
          <ul class="tl">
            <li><span class="t">7:00</span><span class="a">Wake + feed</span></li>
            <li><span class="t">7:50</span><span class="a">Nap</span></li>
            <li><span class="t">9:00</span><span class="a">Wake + feed</span></li>
            <li><span class="t">9:50</span><span class="a">Nap</span></li>
            <li class="rep"><span class="t">↻</span><span class="a">Repeat, day &amp; night</span></li>
          </ul>
        </div>
        <div class="sc">
          <div class="age">4 months · 3–4 naps</div>
          <div class="win">~2-hour windows</div>
          <ul class="tl">
            <li><span class="t">7:00</span><span class="a">Wake</span></li>
            <li><span class="t">9:00</span><span class="a">Nap 1</span></li>
            <li><span class="t">11:30</span><span class="a">Nap 2</span></li>
            <li><span class="t">2:00</span><span class="a">Nap 3</span></li>
            <li class="bed"><span class="t">7:00</span><span class="a">Bedtime</span></li>
          </ul>
        </div>
        <div class="sc">
          <div class="age">6 months · 2–3 naps</div>
          <div class="win">~2.5-hour windows</div>
          <ul class="tl">
            <li><span class="t">7:00</span><span class="a">Wake</span></li>
            <li><span class="t">9:30</span><span class="a">Nap 1</span></li>
            <li><span class="t">1:00</span><span class="a">Nap 2</span></li>
            <li><span class="t">4:00</span><span class="a">Catnap</span></li>
            <li class="bed"><span class="t">7:00</span><span class="a">Bedtime</span></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 3 + 4 -->
    <div class="sec cols">
      <div class="block">
        <div class="sec-title" style="font-size:17px;margin-bottom:12px"><span class="n">3</span>Catch the Sleepy Cues</div>
        <ul class="check">
          <li>Yawning</li>
          <li>Red or raised eyebrows</li>
          <li>Staring into space</li>
          <li>Rubbing eyes / ears</li>
          <li>Clenched fists, jerky moves</li>
          <li>Getting fussy (the <em>late</em> cue!)</li>
        </ul>
      </div>
      <div class="block">
        <div class="sec-title" style="font-size:17px;margin-bottom:12px"><span class="n">4</span>Safe Sleep ABC</div>
        <div class="abc">
          <div><span class="b" style="background:var(--lav)">A</span><div><strong>Alone</strong><small>Own sleep space, no bed-sharing</small></div></div>
          <div><span class="b" style="background:var(--mint)">B</span><div><strong>on the Back</strong><small>Always place baby on their back</small></div></div>
          <div><span class="b" style="background:var(--rose)">C</span><div><strong>in a Crib</strong><small>Firm, flat, bare — no pillows or toys</small></div></div>
        </div>
      </div>
    </div>

    <!-- 5. Tips -->
    <div class="sec">
      <div class="sec-title"><span class="n">5</span>5 Calm-Sleep Tips</div>
      <div class="tips">
        <div class="tip"><span class="e">⏱️</span><p><b>Watch the window, not the clock.</b> Time sleep by wake windows + cues.</p></div>
        <div class="tip"><span class="e">🌙</span><p><b>Dark room + white noise.</b> Mimics the womb, masks noise.</p></div>
        <div class="tip"><span class="e">🔁</span><p><b>Same bedtime routine nightly.</b> Predictability signals sleep.</p></div>
        <div class="tip"><span class="e">😴</span><p><b>Drowsy but awake.</b> Low-pressure practice at self-settling.</p></div>
        <div class="tip"><span class="e">⚡</span><p><b>Beat overtiredness.</b> Overtired babies fight sleep harder — start early.</p></div>
        <div class="tip"><span class="e">🛁</span><p><b>Track what works.</b> Patterns (like "sleeps longer after a bath") hide in the data.</p></div>
      </div>
    </div>

    <!-- CTA -->
    <div class="cta">
      <img src="/mamabee/assets/bee.png" alt="" width="40" height="40" style="border-radius:50%;background:#fff;padding:3px;margin-bottom:8px;box-shadow:0 3px 8px rgba(61,46,32,.15)" /><h2>Let MamaBee do the nap math</h2>
      <p>The calm, AI-powered baby tracker predicts every nap from your baby's real sleep — automatically.</p>
      <a href="https://apps.apple.com/us/app/mamabee-baby-tracker/id6773179521">Get MamaBee — free</a>
    </div>
  </div>

  <div class="foot">
    © MamaBee · Made with honey by parents · realmlabs.app/mamabee
    <div class="med">Every baby is different — this is a friendly guide, not medical advice. Always follow your baby's cues and your pediatrician.</div>
  </div>
</div>
<MamaBeeFooter />
</body>
</html>
