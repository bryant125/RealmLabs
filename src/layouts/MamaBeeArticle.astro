---
import ArticleSeo from '../components/ArticleSeo.astro';
import GtmHead from '../components/GtmHead.astro';
import GtmBody from '../components/GtmBody.astro';
const { title, description, publishedDate, updatedDate, author, cover, canonical, readingTime, related = [], faq = [], tool = null } = Astro.props;
const faqSchema = faq.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) } : null;
const dateFmt = (d) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<!DOCTYPE html>
<html lang="en" data-mood="golden">
<head>
  <GtmHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/mamabee/assets/bee.png" />
  <ArticleSeo brand="MamaBee" {title} {description} {publishedDate} {updatedDate} {author} image={cover} {canonical} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <style>
    :root{
      --honey:#F0B040;--honey-dk:#D89A2E;--honey-lt:#FCE7B5;
      /* match the MamaBee site's data-mood="golden" page background */
      --cream:#FCEBCE;--cream-tint:#FBF1DA;--surface:#fff;
      --ink:#3D2E20;--ink-muted:#8A7A68;--divider:#F0E6D6;
      --radius:20px;--shadow-card:0 10px 30px rgba(61,46,32,.10);
    }
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:"Nunito",system-ui,sans-serif;background:var(--cream);color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.7}
    a{color:var(--honey-dk)}
    /* Header matched to the MamaBee landing-page nav */
    .nav{position:sticky;top:0;z-index:50;background:rgba(252,235,206,.9);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--divider)}
    .nav-inner{max-width:1120px;margin:0 auto;display:flex;align-items:center;gap:28px;height:78px;padding:0 24px}
    .brand{display:inline-flex;align-items:center;gap:12px;font-family:"Nunito",sans-serif;font-weight:900;font-size:1.4rem;letter-spacing:-.02em;color:var(--ink);text-decoration:none}
    .brand .bee-logo{width:46px;height:46px;object-fit:contain;flex:none;filter:drop-shadow(0 3px 5px rgba(61,46,32,.18));transition:transform .25s cubic-bezier(.2,.8,.3,1.4)}
    .brand:hover .bee-logo{transform:rotate(-8deg) scale(1.06)}
    .nav-links{display:flex;gap:8px;margin-left:12px}
    .nav-links a{font-weight:800;font-size:1rem;color:var(--ink-muted);padding:9px 15px;border-radius:12px;white-space:nowrap;text-decoration:none;transition:color .16s,background-color .16s}
    .nav-links a:hover{color:#643018;background:#FDF1D2}
    .nav-cta{margin-left:auto;display:flex;align-items:center;gap:14px}
    .btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;font-size:.98rem;border-radius:15px;font-weight:800;font-family:"Nunito",sans-serif;text-decoration:none;transition:filter .16s,transform .06s}
    .btn-primary{background:linear-gradient(160deg,#F6C158 0%,#E7A636 100%);color:#643018;box-shadow:0 5px 0 #B97E1F,0 4px 16px rgba(61,46,32,.07)}
    .btn-primary:hover{filter:brightness(1.02)}
    .btn-primary:active{transform:translateY(4px);box-shadow:0 1px 0 #B97E1F}
    @media(max-width:760px){
      .nav-inner{height:62px;gap:12px;padding:0 16px}
      .nav-links{display:none}
      .brand{font-size:1.2rem}
      .brand .bee-logo{width:38px;height:38px}
      .nav-cta .btn{min-height:42px;padding:0 16px;font-size:.9rem}
    }
    .wrap{max-width:720px;margin:0 auto;padding:0 20px}
    .article-head{padding:56px 0 32px;text-align:center}
    .eyebrow{display:inline-block;font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--honey-dk);margin-bottom:16px}
    h1{font-size:clamp(30px,5vw,46px);font-weight:900;line-height:1.12;letter-spacing:-.01em}
    .meta{margin-top:18px;color:var(--ink-muted);font-weight:600;font-size:14px}
    .cover{width:100%;max-width:820px;margin:8px auto 0;border-radius:var(--radius);box-shadow:var(--shadow-card);display:block}
    .prose{padding:36px 0 72px;font-size:18px}
    .prose h2{font-size:28px;font-weight:800;margin:40px 0 14px}
    .prose h3{font-size:22px;font-weight:800;margin:30px 0 10px}
    .prose p{margin:0 0 20px}
    .prose ul,.prose ol{margin:0 0 20px 24px}
    .prose li{margin:0 0 8px}
    .prose img{max-width:100%;border-radius:14px;margin:24px 0}
    /* article images + app screenshots */
    .prose figure.shot{margin:30px 0;text-align:center}
    .prose figure.shot img{margin:0 auto;display:block;border-radius:16px}
    .prose figure.shot figcaption{margin-top:12px;font-size:14px;color:var(--ink-muted);font-style:italic;max-width:90%;margin-left:auto;margin-right:auto}
    .prose figure.phone{position:relative}
    .prose figure.phone img{max-width:300px;width:100%;border-radius:30px;border:6px solid #2b2119;box-shadow:0 18px 45px rgba(61,46,32,.28)}
    @media(max-width:600px){ .prose figure.phone img{max-width:240px} }
    .prose blockquote{border-left:4px solid var(--honey);background:var(--cream-tint);padding:14px 20px;border-radius:10px;margin:24px 0;color:var(--ink-muted)}
    /* insertable App-download CTA */
    .prose .article-cta{background:linear-gradient(160deg,#FDF1D2,#FCE7B5);border:1px solid #F0E6D6;border-radius:20px;padding:28px 26px;margin:34px 0;text-align:center}
    .prose .article-cta-h{font-weight:800;font-size:19px;color:var(--ink);margin:0 0 16px}
    .prose .article-cta-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 30px;border-radius:16px;font-weight:800;font-size:1.05rem;font-family:"Nunito",sans-serif;text-decoration:none;background:linear-gradient(160deg,#F6C158,#E7A636);color:#643018;box-shadow:0 5px 0 #B97E1F,0 6px 18px rgba(61,46,32,.12);transition:filter .16s,transform .06s}
    .prose .article-cta-btn:hover{filter:brightness(1.03)}
    .prose .article-cta-btn:active{transform:translateY(4px);box-shadow:0 1px 0 #B97E1F}
    /* contextual free-tool promo at the end of an article */
    .tool-promo{display:flex;gap:18px;align-items:center;background:linear-gradient(160deg,#FDF1D2,#FCE7B5);border:1px solid #F0E6D6;border-radius:20px;padding:22px 24px;margin:34px 0 26px}
    .tool-promo .tp-ico{font-size:40px;line-height:1;flex:none}
    .tool-promo .tp-kicker{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--honey-dk);margin-bottom:4px}
    .tool-promo .tp-title{font-size:20px;font-weight:900;color:var(--ink);margin:0 0 6px}
    .tool-promo .tp-tag{font-size:15px;color:var(--ink-muted);margin:0 0 14px}
    .tool-promo .tp-btn{display:inline-flex;align-items:center;min-height:46px;padding:0 24px;border-radius:14px;font-weight:800;font-size:1rem;text-decoration:none;background:linear-gradient(160deg,#F6C158,#E7A636);color:#643018;box-shadow:0 5px 0 #B97E1F,0 6px 18px rgba(61,46,32,.12);transition:filter .16s,transform .06s}
    .tool-promo .tp-btn:hover{filter:brightness(1.03)}
    .tool-promo .tp-btn:active{transform:translateY(4px);box-shadow:0 1px 0 #B97E1F}
    @media(max-width:520px){.tool-promo{flex-direction:column;text-align:center;gap:10px}}
    .back{display:inline-block;margin:8px 0 0;font-weight:700;color:var(--honey-dk);text-decoration:none}
    /* Keep reading — related article cards */
    .keep-reading{max-width:960px;padding-bottom:20px}
    .kr-title{font-weight:900;font-size:24px;color:var(--ink);margin:0 0 20px}
    .kr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px}
    .kr-card{background:var(--surface);border-radius:18px;box-shadow:var(--shadow-card);overflow:hidden;text-decoration:none;color:inherit;display:flex;flex-direction:column;transition:transform .2s}
    .kr-card:hover{transform:translateY(-4px)}
    .kr-cover{aspect-ratio:16/9;width:100%;object-fit:cover;background:linear-gradient(160deg,#F6C158,#E7A636);display:block}
    .kr-body{padding:16px 18px 18px;display:flex;flex-direction:column;gap:10px}
    .kr-body h3{font-size:16px;font-weight:800;line-height:1.3;color:var(--ink);margin:0}
    .kr-go{font-size:13px;font-weight:800;color:var(--honey-dk)}
    footer{border-top:1px solid var(--divider);padding:32px 0;text-align:center;color:var(--ink-muted);font-size:14px}
    @media(max-width:600px){
      .wrap{padding:0 18px}
      .article-head{padding:32px 0 20px}
      .prose{font-size:17px;padding:28px 0 56px}
      .prose h2{font-size:24px}
      .prose h3{font-size:20px}
      .cover{border-radius:14px}
    }
  </style>
</head>
<body>
  <GtmBody />
  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href="/mamabee/"><img class="bee-logo" src="/mamabee/assets/bee.png" alt="" width="46" height="46" />MamaBee</a>
      <nav class="nav-links">
        <a href="/mamabee/#how">How it works</a>
        <a href="/mamabee/#features">Features</a>
        <a href="/mamabee/#ai">AI</a>
        <a href="/mamabee/#faq">FAQ</a>
        <a href="/mamabee/tools">Free tools</a>
        <a href="/mamabee/articles">Articles</a>
      </nav>
      <div class="nav-cta">
        <a class="btn btn-primary" href="https://apps.apple.com/us/app/mamabee-baby-tracker/id6773179521" target="_blank" rel="noopener">Get the app</a>
      </div>
    </div>
  </header>

  <article>
    <div class="wrap">
      <div class="article-head">
        <span class="eyebrow">MamaBee Journal</span>
        <h1>{title}</h1>
        <div class="meta">By {author} · {dateFmt(publishedDate)}{readingTime ? ` · ${readingTime} min read` : ''}</div>
      </div>
    </div>
    {cover && <img class="cover" src={cover} alt={title} />}
    <div class="wrap">
      <div class="prose">
        <slot />
        {tool ? (
          <aside class="tool-promo">
            <div class="tp-ico">{tool.emoji}</div>
            <div class="tp-body">
              <div class="tp-kicker">Free MamaBee tool</div>
              <h3 class="tp-title">{tool.name}</h3>
              <p class="tp-tag">{tool.tagline}</p>
              <a class="tp-btn" href={`/mamabee/tools/${tool.slug}`}>Try it free →</a>
            </div>
          </aside>
        ) : (
          <aside class="tool-promo">
            <div class="tp-ico">🧮</div>
            <div class="tp-body">
              <div class="tp-kicker">Free MamaBee tools</div>
              <h3 class="tp-title">Skip the guesswork</h3>
              <p class="tp-tag">Instant baby calculators for wake windows, sleep schedules, feeding, and more — free, no sign-up.</p>
              <a class="tp-btn" href="/mamabee/tools">Explore free tools →</a>
            </div>
          </aside>
        )}
        <a class="back" href="/mamabee/articles/">← All MamaBee articles</a>
      </div>
    </div>
  </article>

  {related && related.length > 0 && (
    <section class="wrap keep-reading">
      <h2 class="kr-title">Keep reading</h2>
      <div class="kr-grid">
        {related.map((r) => (
          <a class="kr-card" href={`/mamabee/articles/${r.slug}`}>
            {r.cover ? <img class="kr-cover" src={r.cover} alt={r.title} loading="lazy" /> : <div class="kr-cover"></div>}
            <div class="kr-body"><h3>{r.title}</h3><span class="kr-go">Read next →</span></div>
          </a>
        ))}
      </div>
    </section>
  )}

  <footer>© MamaBee · Made with honey by parents · <a href="/">Realm Labs</a></footer>
</body>
</html>
