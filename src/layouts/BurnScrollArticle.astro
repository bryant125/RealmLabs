---
import ArticleSeo from '../components/ArticleSeo.astro';
import GtmHead from '../components/GtmHead.astro';
import GtmBody from '../components/GtmBody.astro';
const { title, description, publishedDate, updatedDate, author, cover, canonical, readingTime, related = [], faq = [] } = Astro.props;
const faqSchema = faq.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) } : null;
const dateFmt = (d) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<!DOCTYPE html>
<html lang="en">
<head>
  <GtmHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@300;400;600;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/jpeg" href="/burnscroll/logo.jpg" />
  <ArticleSeo brand="BurnScroll" {title} {description} {publishedDate} {updatedDate} {author} image={cover} {canonical} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <style>
    :root{--neon:#CEFF00;--ink:#fff;--muted:#a1a1aa;--bg:#000;--panel:#111;--line:rgba(255,255,255,.1)}
    *{box-sizing:border-box;margin:0;padding:0}
    /* base black + BurnScroll's signature neon glow at the top */
    body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.7}
    body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;background:radial-gradient(circle at 50% 0%,rgba(206,255,0,.05),transparent 50%)}
    body>*{position:relative;z-index:1}
    ::selection{background:var(--neon);color:#000}
    a{color:var(--neon)}
    /* Header matched to the BurnScroll landing-page floating pill nav */
    .nav{position:sticky;top:0;z-index:50;padding:18px 16px 6px;display:flex;justify-content:center}
    .nav-pill{display:flex;align-items:center;gap:6px;padding:8px 8px 8px 16px;background:rgba(255,255,255,.08);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,.1);border-radius:999px;box-shadow:0 20px 60px rgba(0,0,0,.5)}
    .brand{display:flex;align-items:center;gap:10px;font-family:'Outfit',sans-serif;font-weight:900;font-size:16px;letter-spacing:.02em;color:#fff;text-decoration:none}
    .brand img{width:30px;height:30px;border-radius:8px}
    .nav-links{display:flex;gap:2px;margin-left:6px}
    .nav-links a{color:var(--muted);text-decoration:none;font-weight:500;font-size:13px;padding:8px 14px;border-radius:999px;transition:color .16s,background .16s}
    .nav-links a:hover{color:#fff;background:rgba(255,255,255,.06)}
    .nav-app{display:inline-flex;align-items:center;gap:8px;background:#fff;color:#000;font-weight:700;font-size:13px;padding:9px 16px;border-radius:999px;text-decoration:none;margin-left:4px}
    .nav-app:hover{background:#e6e6e6}
    @media(max-width:760px){
      .nav{padding:12px 12px 4px}
      .nav-links{display:none}
      .nav-pill{padding:7px 7px 7px 14px}
      .brand{font-size:15px}
    }
    .wrap{max-width:720px;margin:0 auto;padding:0 20px}
    .article-head{padding:56px 0 32px}
    .eyebrow{display:inline-block;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--neon);margin-bottom:16px}
    h1{font-family:'Outfit',sans-serif;font-size:clamp(30px,5vw,48px);font-weight:900;line-height:1.08;letter-spacing:-.02em}
    .meta{margin-top:18px;color:var(--muted);font-weight:500;font-size:14px}
    .cover{width:100%;max-width:820px;margin:8px auto 0;border-radius:16px;border:1px solid var(--line);display:block}
    .prose{padding:36px 0 72px;font-size:18px;color:#e7e7ea}
    .prose h2{font-family:'Outfit',sans-serif;font-size:28px;font-weight:800;color:#fff;margin:40px 0 14px}
    .prose h3{font-size:22px;font-weight:700;color:#fff;margin:30px 0 10px}
    .prose p{margin:0 0 20px}
    .prose ul,.prose ol{margin:0 0 20px 24px}
    .prose li{margin:0 0 8px}
    .prose img{max-width:100%;border-radius:14px;margin:24px 0}
    .prose blockquote{border-left:3px solid var(--neon);background:var(--panel);padding:14px 20px;border-radius:10px;margin:24px 0;color:var(--muted)}
    .prose code{background:var(--panel);border:1px solid var(--line);padding:2px 6px;border-radius:6px;font-family:'JetBrains Mono',monospace;font-size:.9em}
    /* insertable App-download CTA */
    .prose .article-cta{background:var(--panel);border:1px solid rgba(206,255,0,.25);border-radius:16px;padding:28px 26px;margin:34px 0;text-align:center}
    .prose .article-cta-h{font-family:'Outfit',sans-serif;font-weight:800;font-size:19px;color:#fff;margin:0 0 16px}
    .prose .article-cta-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 30px;border-radius:14px;font-weight:800;font-size:1.05rem;text-decoration:none;background:var(--neon);color:#000;box-shadow:0 6px 24px rgba(206,255,0,.25);transition:transform .06s,box-shadow .16s}
    .prose .article-cta-btn:hover{box-shadow:0 8px 30px rgba(206,255,0,.4)}
    .prose .article-cta-btn:active{transform:translateY(2px)}
    .back{display:inline-block;margin:8px 0 0;font-weight:700;color:var(--neon);text-decoration:none}
    /* Keep reading — related article cards */
    .keep-reading{max-width:960px;padding-bottom:20px}
    .kr-title{font-family:'Outfit',sans-serif;font-weight:800;font-size:24px;color:#fff;margin:0 0 20px}
    .kr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px}
    .kr-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;display:flex;flex-direction:column;transition:transform .2s,border-color .2s}
    .kr-card:hover{transform:translateY(-4px);border-color:rgba(206,255,0,.4)}
    .kr-cover{aspect-ratio:16/9;width:100%;object-fit:cover;background:linear-gradient(160deg,#1a1a1a,#000);display:block}
    .kr-body{padding:16px 18px 18px;display:flex;flex-direction:column;gap:10px}
    .kr-body h3{font-family:'Outfit',sans-serif;font-size:16px;font-weight:800;line-height:1.3;color:#fff;margin:0}
    .kr-go{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--neon)}
    footer{border-top:1px solid var(--line);padding:32px 0;text-align:center;color:var(--muted);font-size:14px}
    @media(max-width:600px){
      .wrap{padding:0 18px}
      .article-head{padding:32px 0 20px}
      .prose{font-size:17px;padding:28px 0 56px}
      .prose h2{font-size:24px}
      .prose h3{font-size:20px}
    }
  </style>
</head>
<body>
  <GtmBody />
  <header class="nav">
    <div class="nav-pill">
      <a class="brand" href="/burnscroll"><img src="/burnscroll/logo.jpg" alt="" width="30" height="30" />BurnScroll</a>
      <nav class="nav-links">
        <a href="/burnscroll/use-cases">Use Cases</a>
        <a href="/burnscroll/features">Features</a>
        <a href="/burnscroll/articles">Articles</a>
        <a href="/burnscroll/contact">Support</a>
      </nav>
      <a class="nav-app" href="https://apps.apple.com/us/app/burnscroll-screen-time-control/id6758544932" target="_blank" rel="noopener">App Store</a>
    </div>
  </header>

  <article>
    <div class="wrap">
      <div class="article-head">
        <span class="eyebrow">BurnScroll Blog</span>
        <h1>{title}</h1>
        <div class="meta">By {author} · {dateFmt(publishedDate)}{readingTime ? ` · ${readingTime} min read` : ''}</div>
      </div>
    </div>
    {cover && <img class="cover" src={cover} alt={title} />}
    <div class="wrap">
      <div class="prose">
        <slot />
        <a class="back" href="/burnscroll/articles">← All BurnScroll articles</a>
      </div>
    </div>
  </article>

  {related && related.length > 0 && (
    <section class="wrap keep-reading">
      <h2 class="kr-title">Keep reading</h2>
      <div class="kr-grid">
        {related.map((r) => (
          <a class="kr-card" href={`/burnscroll/articles/${r.slug}`}>
            {r.cover ? <img class="kr-cover" src={r.cover} alt={r.title} loading="lazy" /> : <div class="kr-cover"></div>}
            <div class="kr-body"><h3>{r.title}</h3><span class="kr-go">Read next →</span></div>
          </a>
        ))}
      </div>
    </section>
  )}

  <footer>© BurnScroll · Burn to unlock · <a href="/">Realm Labs Studio</a></footer>
</body>
</html>
