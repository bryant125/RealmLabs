{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/mamabee",
      "destination": "https://mamabee.app/",
      "permanent": true
    },
    {
      "source": "/mamabee/:path*",
      "destination": "https://mamabee.app/:path*",
      "permanent": true
    }
  ]
}
